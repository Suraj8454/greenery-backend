<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#123b2b" />
  <title>Admin Sign in | Cityscape</title>
  <link rel="stylesheet" href="/css/tailwind.css" />
  <link rel="stylesheet" href="/admin.css" />
</head>
<body class="min-h-screen bg-[#f4f7f3] text-slate-800">
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-10">
    <div class="absolute inset-0 soft-grid opacity-60"></div>
    <div class="absolute -left-24 -top-24 h-72 w-72 rounded-full bg-emerald-200/50 blur-3xl"></div>
    <div class="absolute -bottom-24 -right-16 h-80 w-80 rounded-full bg-lime-100/70 blur-3xl"></div>
    <div class="relative grid w-full max-w-5xl overflow-hidden rounded-[2rem] border border-white/80 bg-white shadow-[0_28px_90px_rgba(21,57,39,.13)] md:grid-cols-2">
      <section class="relative hidden min-h-[590px] flex-col justify-between overflow-hidden bg-gradient-to-br from-[#123b2b] via-[#1d5a3e] to-[#347951] p-10 text-white md:flex lg:p-14">
        <div class="absolute -right-24 -top-16 h-72 w-72 rounded-full border-[42px] border-white/5"></div>
        <div class="absolute -bottom-24 -left-16 h-72 w-72 rounded-full border-[50px] border-emerald-100/10"></div>
        <div class="relative flex items-center gap-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 ring-1 ring-white/20">
            <svg class="h-7 w-7 text-emerald-100" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8 6 4 10 4 16c0 4 4 6 8 6s8-2 8-6c0-6-4-10-8-14z"/></svg>
          </div>
          <div><p class="brand-heading text-xl font-extrabold tracking-tight">Cityscape</p><p class="text-xs uppercase tracking-[.24em] text-emerald-100/80">Store management</p></div>
        </div>
        <div class="relative max-w-sm">
          <span class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-semibold text-emerald-50"><span class="h-2 w-2 rounded-full bg-lime-300"></span> Admin workspace</span>
          <h1 class="brand-heading text-4xl font-extrabold leading-tight lg:text-5xl">Everything your store needs, in one place.</h1>
          <p class="mt-5 max-w-sm text-sm leading-7 text-emerald-50/80">Manage products, keep orders moving, and get a clear view of your business.</p>
        </div>
        <p class="relative text-xs text-emerald-100/65">© <%= new Date().getFullYear() %> Cityscape. Secure administrator access.</p>
      </section>
      <section class="flex items-center p-7 sm:p-10 lg:p-14">
        <div class="mx-auto w-full max-w-md">
          <div class="mb-8 flex items-center gap-3 md:hidden">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#164a34] text-emerald-100"><svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8 6 4 10 4 16c0 4 4 6 8 6s8-2 8-6c0-6-4-10-8-14z"/></svg></div>
            <div><p class="brand-heading text-lg font-extrabold text-[#163d2c]">Cityscape</p><p class="text-xs text-slate-500">Store management</p></div>
          </div>
          <div class="mb-8">
            <p class="mb-3 text-xs font-bold uppercase tracking-[.22em] text-emerald-700">Welcome back</p>
            <h2 class="brand-heading text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Sign in to admin</h2>
            <p class="mt-3 text-sm leading-6 text-slate-500">Enter your administrator credentials to continue.</p>
          </div>
          <% if (error) { %><div role="alert" class="mb-5 flex gap-3 rounded-xl border border-red-100 bg-red-50 p-4 text-sm text-red-700"><span class="font-bold">!</span><span><%= error %></span></div><% } %>
          <form method="POST" action="/admin/login" class="space-y-5">
            <div><label for="email" class="mb-2 block text-sm font-semibold text-slate-700">Email address</label><input id="email" name="email" type="email" autocomplete="username" value="admin@cityscape.com" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm placeholder:text-slate-400 focus:bg-white" placeholder="admin@cityscape.com" /></div>
            <div><div class="mb-2 flex items-center justify-between"><label for="password" class="block text-sm font-semibold text-slate-700">Password</label></div><input id="password" name="password" type="password" autocomplete="current-password" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm placeholder:text-slate-400 focus:bg-white" placeholder="Enter your password" /></div>
            <button type="submit" class="group flex w-full items-center justify-center gap-2 rounded-xl bg-[#174a34] px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-emerald-900/15 hover:-translate-y-0.5 hover:bg-[#216744]">Sign in securely <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
          </form>
          <div class="mt-7 flex items-start gap-3 rounded-xl bg-slate-50 p-4"><svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 11V7a3 3 0 00-6 0v4m-1 0h8a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2z"/></svg><p class="text-xs leading-5 text-slate-500">This area is restricted to authorized administrators. Keep your login credentials private.</p></div>
          <p class="mt-8 text-center text-xs text-slate-400">Protected admin access · Cityscape</p>
        </div>
      </section>
    </div>
  </main>
</body>
</html>
