
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#123b2b" />

  <title>Admin Sign in | Nitar.in</title>

  <link rel="stylesheet" href="/css/tailwind.css" />
  <link rel="stylesheet" href="/admin.css" />
</head>

<body class="min-h-screen bg-[#f4f7f3] text-slate-800">

  <main class="relative flex items-center justify-center min-h-screen px-4 py-10 overflow-hidden">

    <div class="absolute inset-0 soft-grid opacity-60"></div>
    <div class="absolute rounded-full -left-24 -top-24 h-72 w-72 bg-emerald-200/50 blur-3xl"></div>
    <div class="absolute rounded-full -bottom-24 -right-16 h-80 w-80 bg-lime-100/70 blur-3xl"></div>

    <div class="relative grid w-full max-w-5xl overflow-hidden rounded-[2rem] border border-white/80 bg-white shadow-[0_28px_90px_rgba(21,57,39,.13)] md:grid-cols-2">

      <!-- LEFT BRANDING SECTION -->
      <section class="relative hidden min-h-[590px] flex-col justify-between overflow-hidden bg-gradient-to-br from-[#123b2b] via-[#1d5a3e] to-[#347951] p-10 text-white md:flex lg:p-14">

        <div class="absolute -right-24 -top-16 h-72 w-72 rounded-full border-[42px] border-white/5"></div>
        <div class="absolute -bottom-24 -left-16 h-72 w-72 rounded-full border-[50px] border-emerald-100/10"></div>

        <!-- Company Logo -->
        <div class="relative flex items-center gap-3">
          <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-white/10 ring-1 ring-white/20">
            <svg class="h-7 w-7 text-emerald-100" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8 6 4 10 4 16c0 4 4 6 8 6s8-2 8-6c0-6-4-10-8-14z"/>
            </svg>
          </div>

          <div>
            <p class="text-xl font-extrabold tracking-tight brand-heading">
              Nitar.in
            </p>
            <p class="text-xs uppercase tracking-[.24em] text-emerald-100/80">
              Company Management
            </p>
          </div>
        </div>

        <!-- Main Content -->
        <div class="relative max-w-sm">

          <span class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-semibold text-emerald-50">
            <span class="w-2 h-2 rounded-full bg-lime-300"></span>
            Admin Workspace
          </span>

          <h1 class="text-4xl font-extrabold leading-tight brand-heading lg:text-5xl">
            Everything your business needs, in one place.
          </h1>

          <p class="max-w-sm mt-5 text-sm leading-7 text-emerald-50/80">
            Manage your business operations, keep everything organized, and get a clear view of your work.
          </p>

        </div>

        <!-- Copyright -->
        <p class="relative text-xs text-emerald-100/65">
          © <%= new Date().getFullYear() %> Nitar.in. Secure administrator access.
        </p>

      </section>

      <!-- RIGHT LOGIN SECTION -->
      <section class="flex items-center p-7 sm:p-10 lg:p-14">

        <div class="w-full max-w-md mx-auto">

          <!-- Mobile Branding -->
          <div class="flex items-center gap-3 mb-8 md:hidden">

            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#164a34] text-emerald-100">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8 6 4 10 4 16c0 4 4 6 8 6s8-2 8-6c0-6-4-10-8-14z"/>
              </svg>
            </div>

            <div>
              <p class="brand-heading text-lg font-extrabold text-[#163d2c]">
                Nitar.in
              </p>
              <p class="text-xs text-slate-500">
                Company Management
              </p>
            </div>

          </div>

          <!-- Login Heading -->
          <div class="mb-8">

            <p class="mb-3 text-xs font-bold uppercase tracking-[.22em] text-emerald-700">
              Welcome Back
            </p>

            <h2 class="text-3xl font-extrabold tracking-tight brand-heading text-slate-900 sm:text-4xl">
              Admin Sign In
            </h2>

            <p class="mt-3 text-sm leading-6 text-slate-500">
              Enter your administrator credentials to access your dashboard.
            </p>

          </div>

          <!-- Error Message -->
          <% if (error) { %>
            <div role="alert" class="flex gap-3 p-4 mb-5 text-sm text-red-700 border border-red-100 rounded-xl bg-red-50">
              <span class="font-bold">!</span>
              <span><%= error %></span>
            </div>
          <% } %>

          <!-- Login Form -->
          <form method="POST" action="/admin/login" class="space-y-5">

            <div>
              <label for="email" class="block mb-2 text-sm font-semibold text-slate-700">
                Email Address
              </label>

              <input
                id="email"
                name="email"
                type="email"
                autocomplete="username"
                required
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm placeholder:text-slate-400 focus:bg-white"
                placeholder="Enter your email address"
              />
            </div>

            <div>

              <div class="flex items-center justify-between mb-2">
                <label for="password" class="block text-sm font-semibold text-slate-700">
                  Password
                </label>
              </div>

              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm placeholder:text-slate-400 focus:bg-white"
                placeholder="Enter your password"
              />

            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="group flex w-full items-center justify-center gap-2 rounded-xl bg-[#174a34] px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-emerald-900/15 hover:-translate-y-0.5 hover:bg-[#216744]"
            >
              Sign In Securely

              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/>
              </svg>

            </button>

          </form>

          <!-- Security Information -->
          <div class="flex items-start gap-3 p-4 mt-7 rounded-xl bg-slate-50">

            <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 11V7a3 3 0 00-6 0v4m-1 0h8a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2z"/>
            </svg>

            <p class="text-xs leading-5 text-slate-500">
              This area is restricted to authorized administrators. Keep your login credentials private.
            </p>

          </div>

         
<div class="flex items-center justify-center gap-2 mt-8 text-xs text-slate-400">
  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>

  <span>Protected Admin Access</span>

  <span class="text-slate-300">|</span>

  <a
    href="https://nitar.in"
    target="_blank"
    rel="noopener noreferrer"
    class="font-bold text-[#174a34] transition-all duration-200 hover:text-emerald-600 hover:underline underline-offset-4"
  >
    Nitar.in
    <span class="ml-0.5">↗</span>
  </a>
</div>


        </div>

      </section>

    </div>

  </main>

</body>
</html>
