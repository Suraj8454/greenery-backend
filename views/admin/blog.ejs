<div class="min-h-screen p-4 bg-slate-50 sm:p-6 lg:p-8">

  <!-- Header -->
  <div class="flex flex-col justify-between gap-4 mb-8 sm:flex-row sm:items-center">
    <div>
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">
        Content Management
      </p>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
        Blog Articles
      </h1>
      <p class="mt-2 text-sm text-slate-500">
        Create, manage and publish your blog content.
      </p>
    </div>

    <a href="/admin/blog/new"
      class="inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-bold text-white transition shadow-lg rounded-xl bg-emerald-700 shadow-emerald-900/10 hover:bg-emerald-800">
      <span class="text-lg">+</span>
      Add New Article
    </a>
  </div>

  <!-- Statistics -->
  <div class="grid grid-cols-1 gap-4 mb-7 sm:grid-cols-3">

    <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
      <div class="flex items-center justify-between">
        <p class="text-sm font-semibold text-slate-500">Total Articles</p>
        <span class="p-3 rounded-xl bg-slate-100 text-slate-700">📝</span>
      </div>
      <h2 class="mt-4 text-3xl font-extrabold text-slate-900">
        <%= posts.length %>
      </h2>
    </div>

    <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
      <div class="flex items-center justify-between">
        <p class="text-sm font-semibold text-slate-500">Published</p>
        <span class="p-3 rounded-xl bg-emerald-50 text-emerald-700">✓</span>
      </div>
      <h2 class="mt-4 text-3xl font-extrabold text-emerald-700">
        <%= posts.filter(post => Number(post.is_active) === 1).length %>
      </h2>
    </div>

    <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
      <div class="flex items-center justify-between">
        <p class="text-sm font-semibold text-slate-500">Drafts</p>
        <span class="p-3 rounded-xl bg-amber-50 text-amber-700">✎</span>
      </div>
      <h2 class="mt-4 text-3xl font-extrabold text-amber-600">
        <%= posts.filter(post => Number(post.is_active) !== 1).length %>
      </h2>
    </div>

  </div>

  <!-- Articles Table -->
  <div class="overflow-hidden bg-white border shadow-sm rounded-2xl border-slate-200">

    <!-- Toolbar -->
    <div class="flex flex-col justify-between gap-4 p-5 border-b border-slate-100 sm:flex-row sm:items-center">
      <div>
        <h2 class="text-lg font-bold text-slate-900">All Articles</h2>
        <p class="mt-1 text-xs text-slate-500">
          Manage your existing blog posts.
        </p>
      </div>

     
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="w-full min-w-[850px] text-left">

        <thead class="bg-slate-50">
          <tr>
            <th class="px-6 py-4 text-xs font-bold tracking-wider uppercase text-slate-500">
              Article
            </th>
            <th class="px-6 py-4 text-xs font-bold tracking-wider uppercase text-slate-500">
              Category
            </th>
            <th class="px-6 py-4 text-xs font-bold tracking-wider uppercase text-slate-500">
              Meta Title
            </th>
            <th class="px-6 py-4 text-xs font-bold tracking-wider uppercase text-slate-500">
              Status
            </th>
            <th class="px-6 py-4 text-xs font-bold tracking-wider text-right uppercase text-slate-500">
              Actions
            </th>
          </tr>
        </thead>

        <tbody id="blogTableBody" class="divide-y divide-slate-100">

          <% if (posts.length > 0) { %>

            <% posts.forEach(item => { %>

              <tr data-blog-row class="transition hover:bg-slate-50">

                <!-- Article -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-4">

                    <% if (item.image) { %>
                      <img
                        src="<%= item.image %>"
                        alt="<%= item.title %>"
                        class="object-cover w-16 border h-14 rounded-xl border-slate-200"
                      />
                    <% } else { %>
                      <div class="flex items-center justify-center w-16 text-2xl h-14 rounded-xl bg-emerald-50">
                        🌿
                      </div>
                    <% } %>

                    <div class="max-w-xs">
                      <p class="font-bold text-slate-900">
                        <%= item.title %>
                      </p>
                      <p class="mt-1 text-xs text-slate-400">
                        /<%= item.slug %>
                      </p>
                    </div>

                  </div>
                </td>

                <!-- Category -->
                <td class="px-6 py-4">
                  <span class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">
                    <%= item.category || 'Uncategorized' %>
                  </span>
                </td>

                <!-- Meta title -->
                <td class="px-6 py-4">
                  <p class="max-w-[200px] truncate text-sm text-slate-600">
                    <%= item.meta_title || '—' %>
                  </p>
                </td>

                <!-- Status -->
                <td class="px-6 py-4">
                  <% if (Number(item.is_active) === 1) { %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                      Published
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-2 rounded-full bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-700">
                      <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                      Draft
                    </span>
                  <% } %>
                </td>

                <!-- Actions -->
                <td class="px-6 py-4">
                  <div class="flex items-center justify-end gap-2">

                    <a
                      href="/admin/blog/<%= item.id %>/edit"
                      class="px-3 py-2 text-xs font-bold transition border rounded-lg border-slate-200 text-slate-600 hover:border-emerald-600 hover:bg-emerald-50 hover:text-emerald-700">
                      Edit
                    </a>

                    <form
                      action="/admin/blog/<%= item.id %>/delete"
                      method="POST"
                      onsubmit="return confirm('Are you sure you want to delete this article?')">

                      <button
                        type="submit"
                        class="px-3 py-2 text-xs font-bold text-red-600 transition border border-red-100 rounded-lg hover:bg-red-50">
                        Delete
                      </button>

                    </form>

                  </div>
                </td>

              </tr>

            <% }) %>

          <% } else { %>

            <tr>
              <td colspan="5" class="px-6 py-16 text-center">
                <div class="text-4xl">📝</div>
                <h3 class="mt-4 font-bold text-slate-800">No articles yet</h3>
                <p class="mt-2 text-sm text-slate-500">
                  Start by creating your first blog article.
                </p>
                <a href="/admin/blog/new"
                  class="mt-5 inline-flex rounded-xl bg-emerald-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-800">
                  Create Article
                </a>
              </td>
            </tr>

          <% } %>

          <!-- Search empty state: hidden until a search has zero matches -->
          <tr id="blogNoResults" style="display:none">
            <td colspan="5" class="px-6 py-16 text-center">
              <div class="text-4xl">🔍</div>
              <h3 class="mt-4 font-bold text-slate-800">
                No matching articles found
              </h3>
              <p class="mt-2 text-sm text-slate-500">
                Try searching with a different keyword.
              </p>
            </td>
          </tr>

        </tbody>
      </table>
    </div>

    <!-- Footer -->
    <div class="flex flex-col justify-between gap-2 px-5 py-4 border-t border-slate-100 sm:flex-row sm:items-center">
      <p class="text-xs text-slate-500">
        Showing <span id="blogVisibleCount" class="font-bold text-slate-800"><%= posts.length %></span>
        of <%= posts.length %> articles
      </p>
      <p class="text-xs text-slate-400">
        Blog Content Management
      </p>
    </div>

  </div>

</div>

<style>
  #blogTableBody tr[hidden] {
    display: none !important;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const searchInput = document.querySelector('[data-list-search]');
  const articleRows = Array.from(
    document.querySelectorAll('#blogTableBody tr[data-blog-row]')
  );

  const noResults = document.getElementById('blogNoResults');
  const visibleCount = document.getElementById('blogVisibleCount');

  if (!searchInput) return;

  function filterArticles() {
    const query = searchInput.value.trim().toLowerCase();
    let count = 0;

    articleRows.forEach(function (row) {
      const text = row.textContent.toLowerCase();
      const matches = text.includes(query);

      row.hidden = !matches;

      if (matches) {
        count++;
      }
    });

    visibleCount.textContent = count;

    if (noResults) {
      noResults.style.display =
        query.length > 0 && count === 0 ? 'table-row' : 'none';
    }
  }

  searchInput.addEventListener('input', filterArticles);
  filterArticles();
});
</script>
