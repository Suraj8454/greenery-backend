  <!-- <form method="POST" action="/admin/settings/site" class="p-6"> -->
    <form
  method="POST"
  action="/admin/settings/site"
  enctype="multipart/form-data"
  class="p-6"
>

    <% const fields = [
      ['brand_name','Brand name'],
      ['announcement_text','Announcement bar text'],
      ['hero_tagline','Hero tagline (fallback)'],
      ['hero_title','Hero title (fallback)'],
      ['hero_description','Hero description (fallback)'],
      ['footer_heading','Footer heading'],
      ['footer_description','Footer description'],
      ['footer_cta_text','Footer CTA label'],
      ['footer_image_url','Footer background image URL/path'],
      ['brand_tagline','Brand tagline'],
      ['search_placeholder','Search placeholder'],
      ['footer_quick_title','Footer quick-links heading'],
      ['footer_help_title','Footer help heading'],
      ['footer_newsletter_title','Footer newsletter heading'],
      ['navigation_json','Header navigation JSON'],
      ['footer_quick_links_json','Footer quick links JSON'],
      ['footer_help_links_json','Footer help links JSON'],
      ['whatsapp_number','WhatsApp number (country code, digits only)'],
      ['mobile_number','Display mobile number'],
      ['contact_email','Contact email'],
      ['address','Business address'],
      ['instagram_url','Instagram URL'],
      ['facebook_url','Facebook URL'],
      ['twitter_url','Twitter / X URL'],
      ['youtube_url','YouTube URL'],
      ['pinterest_url','Pinterest URL'],
      ['free_shipping_threshold','Free shipping threshold (₹)'],
      ['shipping_fee','Shipping fee (₹)']
    ]; %>

    


    <div class="grid gap-5 sm:grid-cols-2">

      <% fields.forEach(([key,label]) => { %>

        <label class="block text-sm font-semibold text-slate-700">

          <%= label %>

          <% if (key === 'announcement_text') { %>

            <textarea
              name="<%= key %>"
              rows="4"
              placeholder="One announcement per line."
              class="w-full px-4 py-3 mt-2 font-normal transition border outline-none rounded-xl border-slate-200 bg-slate-50 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-600/10"
            ><%= settings[key] || '' %></textarea>

            <span class="block mt-1 text-xs font-normal text-slate-400">
              Enter one announcement per line.
            </span>

          <% } else if (key.endsWith('_json')) { %>

            <textarea
              name="<%= key %>"
              rows="4"
              spellcheck="false"
              class="w-full px-4 py-3 mt-2 font-mono text-xs font-normal transition border outline-none rounded-xl border-slate-200 bg-slate-50 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-600/10"
            ><%= settings[key] || '[]' %></textarea>

          <% } else if (key === 'hero_description' || key === 'footer_description' || key === 'address') { %>

            <textarea
              name="<%= key %>"
              rows="3"
              class="w-full px-4 py-3 mt-2 font-normal transition border outline-none rounded-xl border-slate-200 bg-slate-50 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-600/10"
            ><%= settings[key] || '' %></textarea>

          <% } else { %>

            <input
              type="text"
              name="<%= key %>"
              value="<%= settings[key] || '' %>"
              placeholder="Enter <%= label.toLowerCase() %>"
              class="w-full px-4 py-3 mt-2 font-normal transition border outline-none rounded-xl border-slate-200 bg-slate-50 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-600/10"
            />

          <% } %>

        </label>

      <% }) %>

     

