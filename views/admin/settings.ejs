<!-- SECURITY SECTION -->

<div class="grid max-w-5xl gap-5 lg:grid-cols-[1fr_.8fr]">


  <!-- CHANGE PASSWORD -->

  <section class="p-6 bg-white shadow-sm rounded-2xl ring-1 ring-slate-200/70 sm:p-8">

    <div class="flex items-start gap-4 pb-5 mb-6 border-b border-slate-100">

      <div class="flex items-center justify-center w-12 h-12 shrink-0 rounded-2xl bg-emerald-50 text-emerald-700">

        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <rect x="4" y="10" width="16" height="11" rx="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 10V7a4 4 0 118 0v3m-4 4v3"/>
        </svg>

      </div>

      <div>
        <h2 class="font-bold text-slate-900">
          Change Password
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Update your administrator account password.
        </p>
      </div>

    </div>


    <form id="pwForm" class="space-y-5">

      <div>
        <label for="current" class="block mb-2 text-sm font-semibold text-slate-700">
          Current Password
        </label>

        <input
          id="current"
          type="password"
          autocomplete="current-password"
          required
          class="w-full px-4 py-3 text-sm transition border outline-none rounded-xl border-slate-200 bg-slate-50 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-600/10"
          placeholder="Enter current password"
        />
      </div>


      <div>
        <label for="newPw" class="block mb-2 text-sm font-semibold text-slate-700">
          New Password
        </label>

        <input
          id="newPw"
          type="password"
          autocomplete="new-password"
          required
          minlength="6"
          class="w-full px-4 py-3 text-sm transition border outline-none rounded-xl border-slate-200 bg-slate-50 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-600/10"
          placeholder="At least 6 characters"
        />

        <p class="mt-2 text-xs text-slate-400">
          Use a combination of letters, numbers and symbols.
        </p>
      </div>


      <button
        id="pwSubmit"
        type="submit"
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#174a34] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#216744] disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
      >

        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>

        Update Password
      </button>


      <p id="msg" role="status" aria-live="polite" class="text-sm"></p>

    </form>

  </section>



  <!-- SECURITY CHECKLIST -->

  <aside class="rounded-2xl bg-gradient-to-br from-[#123b2b] to-[#286947] p-6 text-white shadow-lg shadow-emerald-950/10 sm:p-7">

    <div class="flex items-center justify-center w-12 h-12 mb-5 rounded-2xl bg-white/10 text-emerald-100">

      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/>
      </svg>

    </div>


    <h2 class="text-xl font-extrabold brand-heading">
      Security Checklist
    </h2>


    <ul class="mt-5 space-y-4 text-sm leading-6 text-emerald-50/85">

      <li class="flex items-start gap-3">
        <svg class="w-4 h-4 mt-1 shrink-0 text-emerald-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6"/>
        </svg>
        Never share your administrator password.
      </li>

      <li class="flex items-start gap-3">
        <svg class="w-4 h-4 mt-1 shrink-0 text-emerald-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6"/>
        </svg>
        Avoid using the same password on multiple websites.
      </li>

      <li class="flex items-start gap-3">
        <svg class="w-4 h-4 mt-1 shrink-0 text-emerald-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6"/>
        </svg>
        Sign out when using a shared computer.
      </li>

      <li class="flex items-start gap-3">
        <svg class="w-4 h-4 mt-1 shrink-0 text-emerald-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6"/>
        </svg>
        Use a strong password with letters, numbers and symbols.
      </li>

    </ul>


    <div class="p-4 mt-8 border rounded-xl border-white/10 bg-white/10">

      <p class="text-xs font-bold tracking-wider uppercase text-emerald-200">
        Account Protection
      </p>

      <p class="mt-2 text-sm text-white/80">
        Keep your administrator login credentials private and secure.
      </p>

    </div>

  </aside>

</div>


<!-- PASSWORD UPDATE SCRIPT -->

<script>
document.addEventListener('DOMContentLoaded', function () {

  const pwForm = document.getElementById('pwForm');

  if (!pwForm) return;

  pwForm.addEventListener('submit', async function (e) {

    e.preventDefault();

    const currentPassword = document.getElementById('current').value;
    const newPassword = document.getElementById('newPw').value;

    const button = document.getElementById('pwSubmit');
    const msg = document.getElementById('msg');

    if (newPassword.length < 6) {
      msg.textContent = 'New password must be at least 6 characters.';
      msg.className = 'text-sm font-semibold text-rose-600';
      return;
    }

    button.disabled = true;
    button.textContent = 'Updating...';

    msg.textContent = '';

    try {

      const res = await fetch('/admin/api/change-password', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          currentPassword,
          newPassword
        })
      });

      const data = await res.json();

      if (res.ok) {

        msg.textContent = data.message || 'Password changed successfully.';
        msg.className = 'text-sm font-semibold text-emerald-700';

        pwForm.reset();

      } else {

        msg.textContent = data.error || 'Unable to change password.';
        msg.className = 'text-sm font-semibold text-rose-600';

      }

    } catch (error) {

      console.error('Password update error:', error);

      msg.textContent = 'Network error. Please try again.';
      msg.className = 'text-sm font-semibold text-rose-600';

    } finally {

      button.disabled = false;
      button.textContent = 'Update Password';

    }

  });

});
</script>
