<!-- HERO SLIDER HEADER -->

<div class="flex flex-col justify-between gap-4 mb-7 sm:flex-row sm:items-end">

  <div>
    <p class="text-xs font-bold uppercase tracking-[.18em] text-emerald-700">
      Store Management
    </p>

    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900">
      Hero Slider
    </h1>

    <p class="mt-2 text-sm text-slate-500">
      Manage homepage banners, headlines and display order.
    </p>
  </div>

  <a
    href="/admin/slides/new"
    class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#174a34] px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-950/10 transition hover:bg-[#216744]"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/>
    </svg>
    Add New Slide
  </a>

</div>


<!-- STATISTICS -->

<div class="grid gap-4 mb-6 sm:grid-cols-3">

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-slate-500">Total Slides</p>
      <div class="p-3 text-blue-700 rounded-xl bg-blue-50">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 9h18M9 21V9"/>
        </svg>
      </div>
    </div>
    <h2 class="mt-4 text-3xl font-extrabold text-slate-900">
      <%= slides.length %>
    </h2>
  </div>


  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-slate-500">Visible Slides</p>
      <div class="p-3 rounded-xl bg-emerald-50 text-emerald-700">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </div>
    </div>
    <h2 class="mt-4 text-3xl font-extrabold text-emerald-700">
      <%= slides.filter(item => Number(item.is_active) === 1).length %>
    </h2>
  </div>


  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-slate-500">Hidden Slides</p>
      <div class="p-3 rounded-xl bg-amber-50 text-amber-700">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M10.6 10.6a2 2 0 002.8 2.8"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.9 5.2A10.8 10.8 0 0112 5c6.5 0 10 7 10 7a15 15 0 01-3.2 4.1M6.2 6.2C3.5 8 2 12 2 12s3.5 7 10 7c1.1 0 2.1-.2 3-.5"/>
        </svg>
      </div>
    </div>
    <h2 class="mt-4 text-3xl font-extrabold text-amber-600">
      <%= slides.filter(item => Number(item.is_active) !== 1).length %>
    </h2>
  </div>

</div>


<!-- SLIDER TABLE -->

<section class="overflow-hidden bg-white border shadow-sm rounded-2xl border-slate-200">

  <!-- TOOLBAR -->

  <div class="flex flex-col justify-between gap-4 p-5 border-b border-slate-100 sm:flex-row sm:items-center">

    <div>
      <h2 class="text-lg font-extrabold text-slate-900">
        All Homepage Slides
      </h2>
      <p class="mt-1 text-xs text-slate-500">
        View and manage your homepage banners.
      </p>
    </div>


    <div class="relative w-full sm:max-w-xs">

     

      <input
        type="search"
        id="slideSearch"
        placeholder="Search slides..."
        class="w-full py-3 pr-4 text-sm transition border outline-none rounded-xl border-slate-200 bg-slate-50 pl-11 placeholder:text-slate-400 focus:border-emerald-600 focus:bg-white focus:ring-4 focus:ring-emerald-600/10"
      />

    </div>

  </div>


  <!-- TABLE -->

  <div class="overflow-x-auto">

    <table class="w-full min-w-[800px] text-left">

      <thead class="bg-slate-50">

        <tr>
          <th class="px-6 py-4 text-xs font-bold tracking-wider uppercase text-slate-500">
            Preview
          </th>

          <th class="px-6 py-4 text-xs font-bold tracking-wider uppercase text-slate-500">
            Headline
          </th>

          <th class="px-6 py-4 text-xs font-bold tracking-wider uppercase text-slate-500">
            Display Order
          </th>

          <th class="px-6 py-4 text-xs font-bold tracking-wider uppercase text-slate-500">
            Status
          </th>

          <th class="px-6 py-4 text-xs font-bold tracking-wider text-right uppercase text-slate-500">
            Actions
          </th>
        </tr>

      </thead>


      <tbody id="slideTableBody" class="divide-y divide-slate-100">

        <% if (slides.length > 0) { %>

          <% slides.forEach(item => { %>

            <tr data-slide-row class="transition hover:bg-slate-50/70">

              <!-- IMAGE PREVIEW -->

              <td class="px-6 py-4">

                <% if (item.image) { %>

                  <img
                    src="<%= item.image %>"
                    alt="<%= item.title1 %>"
                    loading="lazy"
                    class="object-cover h-16 border w-28 rounded-xl border-slate-200"
                  />

                <% } else { %>

                  <div class="flex items-center justify-center h-16 border w-28 rounded-xl border-slate-200 bg-slate-50 text-slate-400">

                    <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 15l-5-5L5 21"/>
                    </svg>

                  </div>

                <% } %>

              </td>


              <!-- HEADLINE -->

              <td class="px-6 py-4">

                <div class="max-w-xs">

                  <p class="font-bold text-slate-900">
                    <%= item.title1 %>
                  </p>

                  <% if (item.title2) { %>
                    <p class="mt-1 text-sm text-slate-500">
                      <%= item.title2 %>
                    </p>
                  <% } %>

                </div>

              </td>


              <!-- ORDER -->

              <td class="px-6 py-4">

                <span class="inline-flex items-center justify-center px-3 text-sm font-bold rounded-lg h-9 min-w-9 bg-slate-100 text-slate-700">
                  <%= item.sort_order %>
                </span>

              </td>


              <!-- STATUS -->

              <td class="px-6 py-4">

                <% if (Number(item.is_active) === 1) { %>

                  <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    Visible
                  </span>

                <% } else { %>

                  <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">
                    <span class="w-2 h-2 rounded-full bg-slate-400"></span>
                    Hidden
                  </span>

                <% } %>

              </td>


              <!-- ACTIONS -->

              <td class="px-6 py-4">

                <div class="flex items-center justify-end gap-2">

                  <a
                    href="/admin/slides/<%= item.id %>/edit"
                    class="inline-flex items-center gap-2 px-3 py-2 text-xs font-bold transition border rounded-lg border-slate-200 text-slate-600 hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800"
                  >

                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 20h9"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.12 2.12 0 013 3L9 17l-4 1 1-4 10.5-10.5z"/>
                    </svg>

                    Edit
                  </a>


                  <form
                    method="POST"
                    action="/admin/slides/<%= item.id %>/delete"
                    onsubmit="return confirm('Are you sure you want to delete this slide?')"
                  >

                    <button
                      type="submit"
                      class="inline-flex items-center gap-2 px-3 py-2 text-xs font-bold transition border rounded-lg border-rose-100 text-rose-600 hover:bg-rose-50"
                    >

                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4h8v2m-9 0l1 14h8l1-14M10 11v5m4-5v5"/>
                      </svg>

                      Delete

                    </button>

                  </form>

                </div>

              </td>

            </tr>

          <% }) %>


          <!-- SEARCH EMPTY STATE -->

          <tr id="slideNoResults" style="display:none">
            <td colspan="5" class="px-6 py-16 text-center">

              <div class="flex items-center justify-center mx-auto h-14 w-14 rounded-2xl bg-slate-100 text-slate-400">

                <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                  <circle cx="11" cy="11" r="7"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="m20 20-4-4"/>
                </svg>

              </div>

              <h3 class="mt-4 font-bold text-slate-800">
                No matching slides found
              </h3>

              <p class="mt-1 text-sm text-slate-500">
                Try searching with a different keyword.
              </p>

            </td>
          </tr>


        <% } else { %>

          <!-- DATABASE EMPTY STATE -->

          <tr>
            <td colspan="5" class="px-6 py-16 text-center">

              <div class="flex items-center justify-center w-16 h-16 mx-auto rounded-2xl bg-emerald-50 text-emerald-700">

                <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 9h18M9 21V9"/>
                </svg>

              </div>

              <h3 class="mt-4 font-bold text-slate-800">
                No slides available
              </h3>

              <p class="mt-2 text-sm text-slate-500">
                Add your first homepage banner to get started.
              </p>

              <a
                href="/admin/slides/new"
                class="inline-flex items-center gap-2 px-5 py-3 mt-5 text-sm font-bold text-white transition rounded-xl bg-emerald-700 hover:bg-emerald-800"
              >

                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14"/>
                </svg>

                Add First Slide

              </a>

            </td>
          </tr>

        <% } %>

      </tbody>

    </table>

  </div>


  <!-- TABLE FOOTER -->

  <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-t border-slate-100">

    <p class="text-xs text-slate-500">
      Showing
      <strong id="slideVisibleCount" class="font-bold text-slate-800"><%= slides.length %></strong>
      of <%= slides.length %> slides
    </p>

    <p class="text-xs text-slate-400">
      Homepage Slider Management
    </p>

  </div>

</section>


<!-- SEARCH SCRIPT -->

<style>
  #slideTableBody tr[data-slide-row][hidden] {
    display: none !important;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  const searchInput = document.getElementById('slideSearch');

  const rows = Array.from(
    document.querySelectorAll('#slideTableBody tr[data-slide-row]')
  );

  const noResults = document.getElementById('slideNoResults');

  const visibleCount = document.getElementById('slideVisibleCount');

  if (!searchInput) return;

  function filterSlides() {

    const query = searchInput.value.trim().toLowerCase();

    let count = 0;

    rows.forEach(function (row) {

      const matches = row.textContent.toLowerCase().includes(query);

      row.hidden = !matches;

      if (matches) {
        count++;
      }

    });

    if (visibleCount) {
      visibleCount.textContent = count;
    }

    if (noResults) {
      noResults.style.display =
        query.length > 0 && count === 0 ? 'table-row' : 'none';
    }

  }

  searchInput.addEventListener('input', filterSlides);

  filterSlides();

});
</script>
