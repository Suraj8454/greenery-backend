<!-- Header -->
<section class="mb-8">
  <a href="/admin/pages" class="inline-flex items-center gap-2 mb-5 text-sm font-bold transition text-slate-500 hover:text-emerald-700">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m7 7l-7-7 7-7"/>
    </svg>
    Back to pages
  </a>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-emerald-700">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Website content
      </div>

      <h1 class="text-3xl font-extrabold tracking-tight brand-heading text-slate-900">
        Edit page
      </h1>

      <p class="mt-2 text-sm text-slate-500">
        Update your website page title and content.
      </p>
    </div>

    <span class="w-fit rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-600 shadow-sm">
      Editing: <%= pageData.title %>
    </span>
  </div>
</section>

<!-- Editor Form -->
<form
  method="POST"
  action="/admin/pages/<%= pageData.slug %>"
  class="overflow-hidden bg-white border shadow-sm rounded-2xl border-slate-200"
>

  <!-- Form Header -->
  <div class="flex items-center gap-3 px-5 py-5 border-b border-slate-100 bg-slate-50/70 sm:px-7">
    <div class="flex items-center justify-center h-11 w-11 rounded-xl bg-emerald-100 text-emerald-800">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M16.5 3.5a2.12 2.12 0 013 3L8 18l-4 1 1-4 11.5-11.5zM15 5l4 4"/>
      </svg>
    </div>
    <div>
      <h2 class="font-extrabold text-slate-900">Page editor</h2>
      <p class="mt-1 text-xs text-slate-500">Manage page information and HTML content.</p>
    </div>
  </div>

  <div class="p-5 space-y-7 sm:p-7">

    <!-- Page Details -->
    <div>
      <div class="mb-5">
        <h3 class="text-sm font-extrabold text-slate-900">Basic information</h3>
        <p class="mt-1 text-xs text-slate-500">Update the title displayed on your website.</p>
      </div>

      <div>
        <label for="page-title" class="block mb-2 text-sm font-bold text-slate-700">
          Page title <span class="text-rose-500">*</span>
        </label>

        <input
          id="page-title"
          name="title"
          value="<%= pageData.title %>"
          required
          placeholder="Enter page title"
          class="w-full px-4 py-3 text-sm transition border outline-none rounded-xl border-slate-200 bg-slate-50 text-slate-800 placeholder:text-slate-400 focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-50"
        >
      </div>

      <div class="mt-5">
        <label class="block mb-2 text-sm font-bold text-slate-700">Page slug</label>
        <div class="flex items-center overflow-hidden border rounded-xl border-slate-200 bg-slate-100">
          <span class="px-3 py-3 text-xs font-semibold border-r border-slate-200 text-slate-400">
            /api/pages/
          </span>
          <span class="px-3 py-3 text-sm font-semibold truncate text-slate-600">
            <%= pageData.slug %>
          </span>
        </div>
        <p class="mt-2 text-xs text-slate-400">The page slug is managed by the system.</p>
      </div>
    </div>

    <div class="border-t border-slate-100"></div>

    <!-- Content Editor -->
    <div>
      <div class="flex flex-col gap-2 mb-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="text-sm font-extrabold text-slate-900">Page content</h3>
          <p class="mt-1 text-xs text-slate-500">Write or update the HTML content for this page.</p>
        </div>

        <span class="w-fit rounded-lg bg-amber-50 px-3 py-1.5 text-[11px] font-bold text-amber-700">
          HTML supported
        </span>
      </div>

      <textarea
        name="content"
        rows="18"
        spellcheck="false"
        placeholder="Enter page HTML content here..."
        class="w-full px-4 py-4 font-mono text-xs leading-7 transition border outline-none resize-y rounded-xl border-slate-200 bg-slate-50 text-slate-700 placeholder:text-slate-400 focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-50 sm:text-sm"
      ><%= pageData.content %></textarea>

      <div class="flex items-start gap-2 p-3 mt-3 rounded-xl bg-amber-50">
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M12 9v4m0 4h.01M10.3 3.9L1.8 18.2a2 2 0 001.7 3.1h17a2 2 0 001.7-3.1L13.7 3.9a2 2 0 00-3.4 0z"/>
        </svg>
        <p class="text-xs leading-5 text-amber-800">
          <strong>Important:</strong> HTML is allowed. Review your markup carefully before saving. Only add trusted HTML because unsafe markup can create security risks when rendered on your website.
        </p>
      </div>
    </div>

  </div>

  <!-- Footer Actions -->
  <div class="flex flex-col-reverse gap-3 px-5 py-5 border-t border-slate-100 bg-slate-50/70 sm:flex-row sm:items-center sm:justify-between sm:px-7">
    <p class="text-xs text-slate-400">
      Make sure to review your changes before saving.
    </p>

    <div class="flex flex-col-reverse gap-3 sm:flex-row">
      <a
        href="/admin/pages"
        class="inline-flex items-center justify-center px-5 py-3 text-sm font-bold transition bg-white border rounded-xl border-slate-200 text-slate-600 hover:bg-slate-100"
      >
        Cancel
      </a>

      <button
        type="submit"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#174a34] px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-800 active:scale-[0.98]"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        Save changes
      </button>
    </div>
  </div>
</form>
