<section class="mb-6"><p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Operations</p><h1 class="mt-2 text-3xl font-extrabold">Inventory</h1><p class="mt-2 text-sm text-slate-500">Monitor stock levels and record incoming or outgoing stock movements.</p></section>
<div class="mb-6 grid gap-4 sm:grid-cols-3"><div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200"><p class="text-xs font-bold uppercase tracking-wider text-slate-500">Active SKUs</p><p class="mt-2 text-3xl font-extrabold text-slate-900"><%= products.filter(p=>p.is_active).length %></p></div><div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200"><p class="text-xs font-bold uppercase tracking-wider text-slate-500">Units in stock</p><p class="mt-2 text-3xl font-extrabold text-emerald-800"><%= products.reduce((sum,p)=>sum+Number(p.stock_quantity||0),0) %></p></div><div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200"><p class="text-xs font-bold uppercase tracking-wider text-slate-500">Low / out of stock</p><p class="mt-2 text-3xl font-extrabold text-amber-700"><%= products.filter(p=>Number(p.stock_quantity||0)<=5).length %></p></div></div>
<div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200"><div class="border-b p-5"><h2 class="font-bold">Stock overview</h2><p class="mt-1 text-xs text-slate-500">Use adjustments to keep quantities up to date.</p></div><div class="overflow-x-auto"><table class="data-table w-full min-w-[850px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="p-4">Product</th><th class="p-4">SKU</th><th class="p-4">Stock</th><th class="p-4">Status</th><th class="p-4">Adjust stock</th></tr></thead><tbody><% products.forEach(p=>{ %><tr class="border-t border-slate-100"><td class="p-4"><div class="flex items-center gap-3"><% if(p.img){ %><img src="<%= p.img %>" class="h-11 w-11 rounded-lg object-cover" alt=""><% } %><div><p class="font-semibold"><%= p.name %></p><p class="text-xs text-slate-500"><%= p.category||'Uncategorized' %></p></div></div></td><td class="p-4 text-slate-500"><%= p.sku||'—' %></td><td class="p-4 font-bold"><%= p.stock_quantity %></td><td class="p-4"><span class="rounded-full px-3 py-1 text-xs font-bold <%= Number(p.stock_quantity)<=0?'bg-rose-50 text-rose-700':Number(p.stock_quantity)<=5?'bg-amber-50 text-amber-800':'bg-emerald-50 text-emerald-800' %>"><%= Number(p.stock_quantity)<=0?'Out of stock':Number(p.stock_quantity)<=5?'Low stock':'In stock' %></span></td><td class="p-4"><form method="POST" action="/admin/inventory/<%= p.id %>/adjust" class="flex flex-wrap items-center gap-2"><select name="movement_type" class="rounded-lg border border-slate-200 p-2 text-xs"><option value="stock_in">Stock in +</option><option value="stock_out">Stock out −</option><option value="adjustment">Set quantity =</option></select><input name="quantity" type="number" min="0" required class="w-20 rounded-lg border border-slate-200 p-2" placeholder="Qty"><input name="note" class="w-28 rounded-lg border border-slate-200 p-2" placeholder="Note"><button class="rounded-lg bg-emerald-900 px-3 py-2 text-xs font-bold text-white">Save</button></form></td></tr><% }) %></tbody></table></div></div>
<div class="mt-8 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200"><div class="border-b p-5"><h2 class="font-bold">Recent stock movements</h2></div><div class="overflow-x-auto"><table class="w-full min-w-[600px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-4">Date</th><th class="p-4">Product</th><th class="p-4">Movement</th><th class="p-4">Quantity</th><th class="p-4">Note</th></tr></thead><tbody><% movements.forEach(m=>{ %><tr class="border-t"><td class="p-4"><%= new Date(m.created_at).toLocaleString() %></td><td class="p-4"><%= m.product_name %></td><td class="p-4"><%= m.movement_type.replace('_',' ') %></td><td class="p-4 font-bold"><%= m.quantity %></td><td class="p-4 text-slate-500"><%= m.note||'—' %></td></tr><% }) %></tbody></table></div></div>
