<section class="mb-7"><p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Fulfilment centre</p><h1 class="mt-2 text-3xl font-extrabold">Orders</h1><p class="mt-2 text-sm text-slate-500">Compact order register. Open View for customer, delivery, payment, item images, timeline and invoice.</p></section>
<div class="mb-5 grid gap-3 sm:grid-cols-3"><div class="rounded-2xl bg-white p-4 ring-1 ring-slate-200"><p class="text-xs text-slate-500">Total orders</p><p class="mt-1 text-2xl font-extrabold"><%=orders.length%></p></div><div class="rounded-2xl bg-white p-4 ring-1 ring-slate-200"><p class="text-xs text-slate-500">Awaiting fulfilment</p><p class="mt-1 text-2xl font-extrabold"><%=orders.filter(o=>!['Delivered','Cancelled'].includes(o.status)).length%></p></div><div class="rounded-2xl bg-white p-4 ring-1 ring-slate-200"><p class="text-xs text-slate-500">Total order value</p><p class="mt-1 text-2xl font-extrabold">₹<%=orders.reduce((n,o)=>n+Number(o.total||0),0).toLocaleString('en-IN')%></p></div></div>
<div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200"><div class="overflow-x-auto"><table class="w-full min-w-[900px] text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="p-4">Order</th><th class="p-4">Customer</th><th class="p-4">Date</th><th class="p-4">Delivery ETA</th><th class="p-4">Payment</th><th class="p-4">Status</th><th class="p-4 text-right">Total</th><th class="p-4">Action</th></tr></thead><tbody class="divide-y divide-slate-100"><% orders.forEach(o=>{ %><tr class="hover:bg-emerald-50/30"><td class="p-4 font-bold">#CG-<%=String(o.id).padStart(6,'0')%><p class="mt-1 text-xs font-normal text-slate-400"><%=o.items?.length||0%> line items</p></td><td class="p-4"><p class="font-semibold"><%=o.customer_name||o.name||'Customer'%></p><p class="text-xs text-slate-500"><%=o.customer_email||o.user_email||''%></p></td><td class="p-4 text-slate-600"><%=new Date(o.created_at).toLocaleDateString('en-IN')%></td><td class="p-4"><%=o.expected_delivery_date?new Date(o.expected_delivery_date).toLocaleDateString('en-IN'):'Not set'%></td><td class="p-4"><%=o.payment_method||'COD'%><p class="text-xs text-slate-500"><%=o.payment_status||'Pending'%></p></td><td class="p-4"><span class="inline-flex rounded-full px-2.5 py-1 text-xs font-bold <%= o.status==='Delivered' ? 'bg-emerald-50 text-emerald-800' : o.status==='Cancelled' ? 'bg-rose-50 text-rose-700' : o.status==='Shipped' || o.status==='Out for Delivery' ? 'bg-sky-50 text-sky-700' : 'bg-amber-50 text-amber-800' %>"><%=o.status%></span></td><td class="p-4 text-right font-extrabold">₹<%=Number(o.total||0).toLocaleString('en-IN')%></td><td class="p-4"><a href="/admin/orders/<%=o.id%>" class="rounded-lg bg-[#174a34] px-3 py-2 text-xs font-bold text-white">View details</a></td></tr><% }) %></tbody></table></div><% if(!orders.length){%><p class="p-12 text-center text-sm text-slate-500">No orders have been placed yet.</p><%}%></div>
