<section class="mb-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-emerald-700">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Customer care
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
        Contact enquiries
      </h1>
      <p class="mt-2 text-sm text-slate-500">
        Manage customer conversations, follow-ups and incoming messages.
      </p>
    </div>

    <div class="flex items-center gap-2 px-4 py-3 bg-white border shadow-sm rounded-xl border-slate-200">
      <span class="flex items-center justify-center rounded-lg h-9 w-9 bg-emerald-50 text-emerald-700">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
        </svg>
      </span>
      <div>
        <p class="text-xs font-medium text-slate-500">Total enquiries</p>
        <p class="text-xl font-extrabold text-slate-900"><%= messages.length %></p>
      </div>
    </div>
  </div>
</section>

<%
  const newCount = messages.filter(m => m.status === 'New').length;
  const contactedCount = messages.filter(m => m.status === 'Contacted').length;
  const resolvedCount = messages.filter(m => m.status === 'Resolved').length;
%>

<!-- Stats -->
<div class="grid grid-cols-1 gap-4 mb-7 sm:grid-cols-3">
  <div class="p-5 transition bg-white border shadow-sm rounded-2xl border-amber-100 hover:-translate-y-1 hover:shadow-md">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold text-slate-500">New enquiries</p>
        <h3 class="mt-2 text-3xl font-extrabold text-slate-900"><%= newCount %></h3>
      </div>
      <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-amber-50 text-amber-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
    <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-amber-50">
      <div class="h-full rounded-full bg-amber-400" style="width:<%= messages.length ? (newCount/messages.length)*100 : 0 %>%"></div>
    </div>
  </div>

  <div class="p-5 transition bg-white border shadow-sm rounded-2xl border-sky-100 hover:-translate-y-1 hover:shadow-md">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold text-slate-500">Contacted</p>
        <h3 class="mt-2 text-3xl font-extrabold text-slate-900"><%= contactedCount %></h3>
      </div>
      <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-sky-50 text-sky-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.68l1.5 4.5a1 1 0 01-.5 1.21l-2.1 1.05a11 11 0 005.43 5.43l1.05-2.1a1 1 0 011.21-.5l4.5 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z"/>
        </svg>
      </div>
    </div>
    <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-sky-50">
      <div class="h-full rounded-full bg-sky-400" style="width:<%= messages.length ? (contactedCount/messages.length)*100 : 0 %>%"></div>
    </div>
  </div>

  <div class="p-5 transition bg-white border shadow-sm rounded-2xl border-emerald-100 hover:-translate-y-1 hover:shadow-md">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold text-slate-500">Resolved</p>
        <h3 class="mt-2 text-3xl font-extrabold text-slate-900"><%= resolvedCount %></h3>
      </div>
      <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
            d="M5 12l4 4L19 6"/>
        </svg>
      </div>
    </div>
    <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-emerald-50">
      <div class="h-full rounded-full bg-emerald-500" style="width:<%= messages.length ? (resolvedCount/messages.length)*100 : 0 %>%"></div>
    </div>
  </div>
</div>

<!-- Enquiries Table -->
<div class="overflow-hidden bg-white border shadow-sm rounded-2xl border-slate-200">
  <div class="flex flex-col gap-3 px-5 py-5 border-b border-slate-100 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-lg font-extrabold text-slate-900">All enquiries</h2>
      <p class="mt-1 text-xs text-slate-500">Customer messages and follow-up management</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="px-3 py-2 text-xs font-bold rounded-lg bg-slate-100 text-slate-600">
        <%= messages.length %> Records
      </span>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[1050px] text-left text-sm">
      <thead class="bg-slate-50/80 text-[11px] font-bold uppercase tracking-wider text-slate-500">
        <tr>
          <th class="px-5 py-4">Customer</th>
          <th class="px-5 py-4">Message</th>
          <th class="px-5 py-4">Received</th>
          <th class="px-5 py-4">Follow-up</th>
          <th class="px-5 py-4 text-center">Actions</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-slate-100">
        <% messages.forEach(m => { %>
          <tr class="group transition-colors hover:bg-slate-50/80 <%= m.status === 'Resolved' ? 'bg-emerald-50/30' : '' %>">
            <!-- Customer -->
            <td class="px-5 py-5 align-top">
              <div class="flex items-start gap-3">
                <div class="flex items-center justify-center w-10 h-10 text-sm font-extrabold shrink-0 rounded-xl bg-emerald-100 text-emerald-800">
                  <%= (m.name || 'C').charAt(0).toUpperCase() %>
                </div>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <p class="font-bold text-slate-900"><%= m.name %></p>

                    <% if (m.status === 'Resolved') { %>
                      <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-[10px] font-bold text-emerald-700">Resolved</span>
                    <% } else if (m.status === 'Contacted') { %>
                      <span class="rounded-full bg-sky-100 px-2.5 py-1 text-[10px] font-bold text-sky-700">Contacted</span>
                    <% } else { %>
                      <span class="rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-bold text-amber-700">New</span>
                    <% } %>
                  </div>

                  <a href="mailto:<%= m.email %>" class="block text-xs font-medium break-all text-emerald-700 hover:underline">
                    <%= m.email %>
                  </a>
                  <% if (m.phone) { %>
                    <p class="mt-1 text-xs text-slate-500"><%= m.phone %></p>
                  <% } %>
                </div>
              </div>
            </td>

            <!-- Message -->
            <td class="max-w-sm px-5 py-5 align-top">
              <p class="leading-6 break-words whitespace-pre-wrap text-slate-600"><%= m.message %></p>
            </td>

            <!-- Date -->
            <td class="px-5 py-5 align-top whitespace-nowrap">
              <p class="font-semibold text-slate-700"><%= new Date(m.created_at).toLocaleDateString('en-IN') %></p>
              <p class="mt-1 text-xs text-slate-400"><%= new Date(m.created_at).toLocaleTimeString('en-IN', {hour:'2-digit', minute:'2-digit'}) %></p>
            </td>

            <!-- Follow-up -->
            <td class="w-64 px-5 py-5 align-top">
              <form method="POST" action="/admin/contact-messages/<%= m.id %>/status" class="space-y-2">
                <select name="status" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-semibold text-slate-700 outline-none transition focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100">
                  <% ['New', 'Contacted', 'Resolved'].forEach(s => { %>
                    <option value="<%= s %>" <%= m.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>

                <input
                  name="admin_note"
                  value="<%= m.admin_note || '' %>"
                  placeholder="Add private note..."
                  class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-xs outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100"
                >

                <button class="w-full rounded-xl bg-[#174a34] px-3 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-800 active:scale-[0.98]">
                  Save follow-up
                </button>
              </form>
            </td>

            <!-- Actions -->
            <td class="px-5 py-5 align-top">
              <div class="flex flex-col items-center gap-2">
                <% if (m.phone) { %>
                  <a
                    href="https://wa.me/<%= String(m.phone).replace(/[^0-9]/g, '') %>"
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex w-28 items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-xs font-bold text-emerald-800 transition hover:bg-emerald-100"
                  >
                    WhatsApp
                  </a>
                <% } %>

                <a href="mailto:<%= m.email %>" class="inline-flex w-28 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-bold text-slate-600 transition hover:border-sky-200 hover:bg-sky-50 hover:text-sky-700">
                  Email
                </a>

                <form method="POST" action="/admin/contact-messages/<%= m.id %>/delete" onsubmit="return confirm('Are you sure you want to delete this enquiry?')">
                  <button class="w-28 rounded-xl border border-rose-200 bg-white px-3 py-2.5 text-xs font-bold text-rose-600 transition hover:bg-rose-50">
                    Delete
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (!messages.length) { %>
    <div class="px-6 py-20 text-center">
      <div class="flex items-center justify-center w-16 h-16 mx-auto rounded-2xl bg-slate-100 text-slate-400">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
            d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
        </svg>
      </div>
      <h3 class="mt-4 text-base font-bold text-slate-800">No enquiries yet</h3>
      <p class="mt-1 text-sm text-slate-500">New customer messages will appear here.</p>
    </div>
  <% } %>
</div>
