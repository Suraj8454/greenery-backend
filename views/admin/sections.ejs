<section class="mb-7"><p class="text-xs font-bold tracking-widest uppercase text-emerald-700">Storefront content studio</p><h1 class="mt-2 text-3xl font-extrabold">Homepage content</h1><p class="max-w-3xl mt-2 text-sm text-slate-500">Keep the original storefront design. Change text, headings, images, icons, colours and card content here without editing React code.</p></section>
<div class="flex items-center gap-3 p-4 mb-6 bg-white border shadow-sm rounded-2xl border-emerald-100"><div class="flex items-center justify-center h-11 w-11 rounded-xl bg-emerald-50 text-emerald-800"><svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 12h18"/></svg></div><div><p class="font-bold text-slate-800">Section editor</p><p class="text-sm text-slate-500">Edit the selected homepage section from the sidebar. Images are uploaded from your device.</p></div></div>
<% const headingKeys=['best_sellers','our_products','new_arrivals','category_section','testimonials']; const itemKeys=['featured_in','trust_badges','how_it_works','why_choose_us','plant_story','bulk_order','hero_features','hero_stats']; const tabKeys={featured_in:['featured_in'],trust_badges:['trust_badges'],how_it_works:['how_it_works'],why_choose_us:['why_choose_us'],plant_story:['plant_story'],bulk_order:['bulk_order'],headings:headingKeys}; const labelMap={featured_in:'Featured In',trust_badges:'Trust Badges',how_it_works:'How It Works',why_choose_us:'Why Choose Us',plant_story:'Plant Story',bulk_order:'Bulk Orders',best_sellers:'Our Bestsellers',our_products:'Our Products',new_arrivals:'New Arrivals',category_section:'Categories',testimonials:'Testimonials',hero_features:'Hero feature badges',hero_stats:'Hero stats'}; %>
<div class="overflow-hidden bg-white shadow-sm rounded-2xl ring-1 ring-slate-200"><div class="table-wrap"><table class="data-table w-full min-w-[850px] text-left text-sm"><thead class="text-xs tracking-wide uppercase bg-slate-50 text-slate-500"><tr><th class="p-4">Section</th><th class="p-4">Heading</th><th class="p-4">Subheading / description</th><th class="p-4">Style</th><th class="p-4">Visibility</th><th class="p-4">Actions</th></tr></thead><tbody class="divide-y divide-slate-100">
<% sections.forEach(s=>{ const belongs=(tabKeys[activeTab]||[]).includes(s.section_key); const headingOnly=headingKeys.includes(s.section_key); const hasItems=itemKeys.includes(s.section_key); const hasImage=['why_choose_us','plant_story','bulk_order'].includes(s.section_key); %>
<tr id="<%=s.section_key%>" data-section-key="<%=s.section_key%>" data-section-tab="<%=headingKeys.includes(s.section_key)?'headings':s.section_key%>" class="<%=belongs?'':'hidden'%> align-top hover:bg-emerald-50/40"><td class="p-4"><p class="font-bold"><%=labelMap[s.section_key]||s.section_key.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase())%></p><p class="mt-1 text-xs text-slate-400"><%=s.section_key%></p></td><td class="p-4 font-semibold"><%=s.title||'—'%><p class="mt-1 text-xs font-normal text-slate-500"><%=s.eyebrow||''%></p></td><td class="max-w-sm p-4 text-slate-600"><%=s.description||'—'%></td><td class="p-4"><div class="flex items-center gap-2"><span class="w-5 h-5 border rounded-full" style="background:<%=s.color||'#1a3c2e'%>"></span><span class="w-5 h-5 border rounded-full" style="background:<%=s.accent_color||'#2d6a4f'%>"></span><span class="text-xs text-slate-500"><%=s.icon||'—'%></span></div><p class="mt-1 text-xs text-slate-400">Order <%=s.sort_order%></p></td><td class="p-4"><span class="rounded-full px-2.5 py-1 text-xs font-bold <%=s.is_active?'bg-emerald-50 text-emerald-800':'bg-slate-100 text-slate-500'%>"><%=s.is_active?'Visible':'Hidden'%></span></td><td class="p-4"><a href="#edit-<%=s.id%>" onclick="document.getElementById('edit-<%=s.id%>').open=true" class="px-3 py-2 text-xs font-bold text-white rounded-lg bg-emerald-900">Edit</a></td></tr>
<tr data-edit-tab="<%=headingKeys.includes(s.section_key)?'headings':s.section_key%>" class="<%=belongs?'':'hidden'%>"><td colspan="6" class="px-4 pb-4"><details id="edit-<%=s.id%>" class="p-4 border rounded-xl border-slate-200 bg-slate-50/70"><summary class="text-sm font-extrabold cursor-pointer text-emerald-900">Edit <%=labelMap[s.section_key]||s.section_key%></summary><form method="POST" enctype="multipart/form-data" action="/admin/sections" class="grid gap-3 mt-4 md:grid-cols-2">
<input type="hidden" name="section_key" value="<%=s.section_key%>"><input type="hidden" name="return_tab" value="<%=activeTab%>"><input type="hidden" name="image" value="<%=s.image||''%>">
<% (headingOnly?[['title','Heading'],['eyebrow','Small label'],['description','Subheading'],['color','Heading colour'],['accent_color','Accent colour'],['button_text','Button text'],['button_url','Button link'],['sort_order','Display order']]:[['title','Heading / title'],['eyebrow','Small label / eyebrow'],['description','Subheading / description'],['icon','Lucide icon name'],['color','Main text colour'],['accent_color','Accent / icon colour'],['button_text','Button text'],['button_url','Button link'],['sort_order','Display order']]).forEach(([k,l])=>{%><label class="text-xs font-bold text-slate-600"><%=l%><% if(k==='icon'){%><div class="flex gap-2 mt-1"><input name="icon" value="<%=s.icon||''%>" class="flex-1 h-12 min-w-0 p-2 text-sm font-normal bg-white border lucide-icon-value rounded-xl border-slate-200" readonly><button type="button" class="px-3 text-xs font-bold border open-icon-picker rounded-xl border-emerald-200 bg-emerald-50 text-emerald-900">Choose icon</button></div><%}else{%><input name="<%=k%>" value="<%=s[k]??''%>" <%=k==='color'||k==='accent_color'?'type="color"':''%> class="w-full h-12 p-2 mt-1 text-sm font-normal bg-white border rounded-xl border-slate-200"><%}%></label><%})%>
<% if(hasImage){ %><label class="text-xs font-bold text-slate-600">Section image<input type="file" name="image_file" accept="image/*" class="w-full p-3 mt-1 text-sm font-normal bg-white border rounded-xl"><% if(s.image){ %><span class="block mt-2 text-xs text-slate-500">Current image is kept unless you upload a replacement.</span><% } %></label><% } else { %><input type="hidden" name="image_file" value=""><% } %>
<% if(hasItems){ %><div class="p-4 bg-white border md:col-span-2 rounded-xl border-slate-200"><div class="flex flex-wrap items-center justify-between gap-2 mb-3"><div><p class="text-sm font-extrabold text-slate-800">Section items</p><p class="text-xs font-normal text-slate-500">Manage only the items used by this homepage section.</p></div><button type="button" class="px-3 py-2 text-xs font-bold border rounded-lg add-cms-card border-emerald-200 text-emerald-900">＋ Add item</button></div><textarea class="hidden items-json-source" name="items_json"><%=s.items_json||'[]'%></textarea><div class="grid gap-3 cms-card-editor md:grid-cols-2"></div></div><% } else { %><input type="hidden" name="items_json" value="<%=s.items_json||'[]'%>"><% } %>
<label class="text-xs font-bold text-slate-600">Visibility<select name="is_active" class="w-full p-3 mt-1 bg-white border rounded-xl"><option value="1" <%=s.is_active?'selected':''%>>Visible</option><option value="0" <%=!s.is_active?'selected':''%>>Hidden</option></select></label><button class="self-end p-3 font-bold text-white rounded-xl bg-emerald-900">Save changes</button></form></details></td></tr>
<% }) %></tbody></table></div>
</div>
<dialog id="lucidePicker" class="w-[min(760px,94vw)] rounded-2xl p-0 shadow-2xl backdrop:bg-slate-950/50"><div class="p-5 border-b border-slate-100"><div class="flex items-center justify-between gap-3"><div><h2 class="text-lg font-extrabold text-slate-900">Choose a Lucide icon</h2><p class="mt-1 text-sm text-slate-500">Search and select an icon. Its Lucide name will be saved.</p></div><button type="button" id="closeIconPicker" class="px-3 py-2 rounded-lg text-slate-500 hover:bg-slate-100">✕</button></div><input id="iconSearch" placeholder="Search icons e.g. leaf, truck, heart" class="w-full p-3 mt-4 text-sm border outline-none rounded-xl border-slate-200 focus:border-emerald-600"></div><div id="iconGrid" class="grid max-h-[55vh] grid-cols-2 gap-2 overflow-y-auto p-4 sm:grid-cols-4"></div></dialog>
<script>
(() => {
  const iconNames = `activity air-vent alarm-clock alarm-check apple archive arrow-down arrow-left arrow-right arrow-up award axe baby backpack badge-check banknote baseline battery charging beaker bell bike binoculars bird book-open bookmark bot box box-seam briefcase brush bug building building-2 bus cactus cake calendar camera check check-circle check-circle-2 chef-hat cherry-plant circle-help clipboard clock cloud code coffee cog compass contact copy credit-card crop crown database diamond door-open download droplet droplets earth flower flower-2 focus frame funnel gift globe grid-2x2 hammer hand-heart handshake headphones heart heart-handshake history home house image images inbox instagram key leaf life-buoy lightbulb link list-check list-filter locate mail map map-pin medal menu message-circle messages microscope minus monitor moon more-horizontal mountain mouse-pointer move newspaper package package-check paintbrush palette panel-left panels-top-left percent phone phone-call pin plant plug plus plus-circle power printer puzzle quote recycle refresh-cw rocket route rows-3 ruler search send server settings settings-2 shield shield-check ship shirt shopping-bag shopping-cart shovel shower snowflake sparkles speaker sprout star store sun sunrise tag tags target thermometer thumbs-up ticket timer tree trees trophy truck truck-electric umbrella undo user user-check user-round users utensils video wallet wand-sparkles warehouse waves web-hook wifi wind wrench x youtube`.split(/\s+/);
  const dialog=document.getElementById('lucidePicker'), grid=document.getElementById('iconGrid'), search=document.getElementById('iconSearch'); let target=null;
  const draw=(q='')=>{grid.innerHTML='';iconNames.filter(n=>n.includes(q.toLowerCase().trim())).forEach(name=>{const b=document.createElement('button');b.type='button';b.className='flex items-center gap-2 rounded-xl border border-slate-200 p-3 text-left text-xs font-semibold text-slate-700 hover:border-emerald-500 hover:bg-emerald-50';b.innerHTML='<span class="flex items-center justify-center w-8 h-8 rounded-lg bg-slate-100 text-emerald-800"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 12h18"/></svg></span><span>'+name+'</span>';b.addEventListener('click',()=>{if(target){target.value=name;target.dispatchEvent(new Event('input',{bubbles:true}));}dialog.close();});grid.appendChild(b);});};
  document.addEventListener('click',e=>{const btn=e.target.closest('.open-icon-picker');if(!btn)return;const wrap=btn.closest('label');target=wrap?.querySelector('input[name="icon"]')||wrap?.querySelector('[data-field="icon"]');if(!target){const card=btn.closest('.cms-card-editor > div');target=card?.querySelector('[data-field="icon"]');}search.value='';draw();dialog.showModal();search.focus();});
  search.addEventListener('input',()=>draw(search.value));document.getElementById('closeIconPicker').addEventListener('click',()=>dialog.close());
  const safeParse=value=>{try{const v=JSON.parse(value||'[]');return Array.isArray(v)?v:[];}catch{return[];}};
  document.querySelectorAll('form[action="/admin/sections"]').forEach(form=>{const source=form.querySelector('.items-json-source'),editor=form.querySelector('.cms-card-editor');if(!source||!editor)return;const sectionKey=form.querySelector('[name=section_key]')?.value||'';let items=safeParse(source.value);const render=()=>{editor.innerHTML='';items.forEach((item,index)=>{const title=item.title??item.name??item.value??'',desc=item.description??item.sub??item.label??item.desc??'',color=/^#[0-9a-f]{6}$/i.test(item.color||'')?item.color:'#2d6a4f';const card=document.createElement('div');card.className='rounded-xl border border-slate-200 bg-slate-50 p-3';card.innerHTML=`<div class="flex items-center justify-between mb-3"><span class="text-xs font-extrabold text-slate-600">Item ${index+1}</span><button type="button" class="px-2 py-1 text-xs font-bold rounded-md remove-card text-rose-700">Remove</button></div><div class="grid gap-2"><label class="text-xs font-bold text-slate-600">Title / name / value<input data-field="title" class="mt-1 w-full rounded-lg border bg-white p-2.5 text-sm font-normal"></label><label class="text-xs font-bold text-slate-600">Description / subtitle / label<input data-field="description" class="mt-1 w-full rounded-lg border bg-white p-2.5 text-sm font-normal"></label><div class="grid grid-cols-[1fr_80px] gap-2"><label class="text-xs font-bold text-slate-600">Icon<div class="flex gap-1 mt-1"><input data-field="icon" readonly class="flex-1 min-w-0 p-2 text-sm font-normal bg-white border rounded-lg"><button type="button" class="px-2 text-xs bg-white border rounded-lg open-icon-picker">Choose</button></div></label><label class="text-xs font-bold text-slate-600">Colour<input data-field="color" type="color" class="w-full h-10 p-1 mt-1 bg-white border rounded-lg"></label></div><label class="text-xs font-bold text-slate-600">Upload item image<input type="file" name="item_image_${index}" accept="image/*" class="w-full p-2 mt-1 text-sm font-normal bg-white border rounded-lg"></label>${sectionKey==='plant_story'?'<label class="text-xs font-bold text-slate-600">Care tips (JSON: label/value/icon)<textarea data-field="tips" rows="4" class="w-full p-2 mt-1 text-xs font-normal bg-white border rounded-lg"></textarea></label>':''}</div></div>`;card.querySelector('[data-field="title"]').value=title;card.querySelector('[data-field="description"]').value=desc;card.querySelector('[data-field="icon"]').value=item.icon||'leaf';card.querySelector('[data-field="color"]').value=color;const tipsField=card.querySelector('[data-field="tips"]');if(tipsField)tipsField.value=JSON.stringify(Array.isArray(item.tips)?item.tips:[],null,2);card.querySelectorAll('[data-field]').forEach(input=>input.addEventListener('input',()=>{const key=input.dataset.field,targetItem=items[index];if(key==='title'){const prop=Object.prototype.hasOwnProperty.call(targetItem,'name')&&!Object.prototype.hasOwnProperty.call(targetItem,'title')?'name':Object.prototype.hasOwnProperty.call(targetItem,'value')&&!Object.prototype.hasOwnProperty.call(targetItem,'title')?'value':'title';targetItem[prop]=input.value;}else if(key==='description'){const prop=Object.prototype.hasOwnProperty.call(targetItem,'sub')&&!Object.prototype.hasOwnProperty.call(targetItem,'description')?'sub':Object.prototype.hasOwnProperty.call(targetItem,'label')&&!Object.prototype.hasOwnProperty.call(targetItem,'description')?'label':Object.prototype.hasOwnProperty.call(targetItem,'desc')&&!Object.prototype.hasOwnProperty.call(targetItem,'description')?'desc':'description';targetItem[prop]=input.value;}else if(key==='tips'){try{targetItem.tips=JSON.parse(input.value||'[]');input.setCustomValidity('');}catch{input.setCustomValidity('Enter valid JSON for care tips');}}else targetItem[key]=input.value;source.value=JSON.stringify(items,null,2);}));card.querySelector('.remove-card').addEventListener('click',()=>{items.splice(index,1);source.value=JSON.stringify(items,null,2);render();});editor.appendChild(card);});source.value=JSON.stringify(items,null,2);};form.querySelector('.add-cms-card')?.addEventListener('click',()=>{items.push({title:'',description:'',icon:'leaf',color:'#2d6a4f'});render();});form.addEventListener('submit',()=>source.value=JSON.stringify(items,null,2));render();});
})();
</script>
