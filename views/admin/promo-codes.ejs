<div class="flex flex-wrap items-end justify-between gap-4 mb-7">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[.16em] text-emerald-700">
      Store management
    </p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">
      Promo codes
    </h1>
    <p class="mt-2 text-sm text-slate-500">
      Create and manage discounts, usage limits and minimum order values.
    </p>
  </div>

  <a
    href="/admin/promo-codes/new"
    class="inline-flex items-center gap-2 rounded-xl bg-emerald-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-900"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5"/>
    </svg>
    Add promo code
  </a>
</div>

<%
  const totalPromos = promos.length;

  const totalUsage = promos.reduce(
    (sum, item) => sum + (Number(item.used_count) || 0),
    0
  );

  const unlimitedPromos = promos.filter(
    item => !item.usage_limit || Number(item.usage_limit) === 0
  ).length;
%>

<!-- Stats -->
<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-3">

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Total promo codes</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 text-slate-600">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 13.5l-7 7a2 2 0 01-2.8 0l-7.2-7.2a2 2 0 010-2.8l7-7h7l3 3v7z"/>
          <circle cx="14.5" cy="9.5" r="1"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-slate-900"><%= totalPromos %></p>
    <p class="mt-1 text-xs text-slate-500">All created promo codes</p>
  </div>

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Total redemptions</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 12l5 5L20 6"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-emerald-700"><%= totalUsage %></p>
    <p class="mt-1 text-xs text-slate-500">Total recorded uses</p>
  </div>

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Unlimited usage</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-amber-50 text-amber-700">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12a4 4 0 010-8c2.2 0 3.5 2 4 4 .5-2 1.8-4 4-4a4 4 0 010 8c-2.2 0-3.5 2-4 4-.5-2-1.8-4-4-4z"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-amber-700"><%= unlimitedPromos %></p>
    <p class="mt-1 text-xs text-slate-500">Without a usage limit</p>
  </div>

</div>



<!-- Promo codes table -->
<div class="overflow-hidden bg-white border shadow-sm rounded-2xl border-slate-200">

  <% if (promos.length) { %>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[850px] text-left text-sm">

        <thead class="text-xs font-semibold tracking-wide uppercase bg-slate-50 text-slate-500">
          <tr>
            <th class="px-5 py-4">Promo code</th>
            <th class="px-5 py-4">Discount</th>
            <th class="px-5 py-4">Minimum order</th>
            <th class="px-5 py-4">Usage</th>
            <th class="px-5 py-4 text-right">Actions</th>
          </tr>
        </thead>

        <tbody id="promoTableBody" class="divide-y divide-slate-100">

          <% promos.forEach(item => { %>
            <tr data-promo-row class="transition hover:bg-slate-50/70">

              <!-- Code -->
              <td class="px-5 py-4">
                <div class="flex items-center gap-3">
                  <div class="flex items-center justify-center w-10 h-10 shrink-0 rounded-xl bg-emerald-50 text-emerald-700">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 13.5l-7 7a2 2 0 01-2.8 0l-7.2-7.2a2 2 0 010-2.8l7-7h7l3 3v7z"/>
                      <circle cx="14.5" cy="9.5" r="1"/>
                    </svg>
                  </div>

                  <span class="font-semibold tracking-wide uppercase text-slate-900">
                    <%= item.code %>
                  </span>
                </div>
              </td>

              <!-- Discount -->
              <td class="px-5 py-4">
                <span class="inline-flex rounded-lg bg-emerald-50 px-2.5 py-1.5 text-xs font-semibold text-emerald-800">
                  <%= item.discount_type === 'percent'
                    ? item.discount_value + '% OFF'
                    : '₹' + item.discount_value + ' OFF' %>
                </span>
              </td>

              <!-- Minimum order -->
              <td class="px-5 py-4 font-medium text-slate-700">
                ₹<%= Number(item.min_order || 0).toLocaleString('en-IN') %>
              </td>

              <!-- Usage -->
              <td class="px-5 py-4">
                <div class="flex flex-col gap-1">
                  <span class="font-medium text-slate-700">
                    <%= item.used_count || 0 %>
                    /
                    <%= item.usage_limit || '∞' %>
                  </span>

                  <% if (item.usage_limit && Number(item.usage_limit) > 0) { %>
                    <div class="h-1.5 w-24 overflow-hidden rounded-full bg-slate-100">
                      <div
                        class="h-full rounded-full bg-emerald-600"
                        style="width: <%= Math.min(100, (Number(item.used_count || 0) / Number(item.usage_limit)) * 100) %>%"
                      ></div>
                    </div>
                  <% } else { %>
                    <span class="text-xs text-slate-400">No usage limit</span>
                  <% } %>
                </div>
              </td>

              <!-- Actions -->
              <td class="px-5 py-4">
                <div class="flex items-center justify-end gap-2">

                  <a
                    href="/admin/promo-codes/<%= item.id %>/edit"
                    title="Edit promo code"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800"
                  >
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16 4 4 4M4 20l4-.8L19 8a2.1 2.1 0 00-3-3L5 16l-1 4z"/>
                    </svg>
                    Edit
                  </a>

                  <form
                    method="POST"
                    action="/admin/promo-codes/<%= item.id %>/delete"
                    onsubmit="return confirm('Are you sure you want to delete this promo code?')"
                  >
                    <button
                      type="submit"
                      title="Delete promo code"
                      class="inline-flex items-center gap-1.5 rounded-lg border border-rose-100 px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-50"
                    >
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M10 11v6m4-6v6M5 7l1 13h12l1-13M9 7V4h6v3"/>
                      </svg>
                      Delete
                    </button>
                  </form>

                </div>
              </td>

            </tr>
          <% }) %>

        </tbody>
      </table>
    </div>

    <!-- No search results -->
    <div id="promoNoResults" class="hidden px-6 text-center py-14">
      <div class="flex items-center justify-center w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-500">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="7"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="m16 16 4 4"/>
        </svg>
      </div>
      <p class="mt-3 text-sm font-semibold text-slate-800">No matching promo codes found</p>
      <p class="mt-1 text-sm text-slate-500">Try another promo code or discount value.</p>
    </div>

  <% } else { %>

    <!-- Empty state -->
    <div class="px-6 py-16 text-center">
      <div class="flex items-center justify-center mx-auto h-14 w-14 rounded-2xl bg-emerald-50 text-emerald-700">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 13.5l-7 7a2 2 0 01-2.8 0l-7.2-7.2a2 2 0 010-2.8l7-7h7l3 3v7z"/>
          <circle cx="14.5" cy="9.5" r="1"/>
        </svg>
      </div>
      <h3 class="mt-4 text-base font-semibold text-slate-900">No promo codes yet</h3>
      <p class="mt-1 text-sm text-slate-500">Create your first discount code to get started.</p>

      <a
        href="/admin/promo-codes/new"
        class="mt-5 inline-flex items-center gap-2 rounded-xl bg-emerald-800 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-900"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5"/>
        </svg>
        Add first promo code
      </a>
    </div>

  <% } %>

</div>

<script>
  (() => {
    const searchInput = document.getElementById('promoSearch');
    const rows = document.querySelectorAll('[data-promo-row]');
    const countElement = document.getElementById('promoCount');
    const noResults = document.getElementById('promoNoResults');

    if (!searchInput) return;

    searchInput.addEventListener('input', (event) => {
      const query = event.target.value.trim().toLowerCase();
      let visibleCount = 0;

      rows.forEach((row) => {
        const matches = row.textContent.toLowerCase().includes(query);

        row.hidden = !matches;

        if (matches) visibleCount++;
      });

      if (countElement) {
        countElement.textContent = visibleCount;
      }

      if (noResults) {
        noResults.classList.toggle(
          'hidden',
          visibleCount !== 0 || query === ''
        );
      }
    });
  })();
</script>
