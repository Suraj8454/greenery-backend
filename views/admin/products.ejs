<section class="mb-7 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="mb-2 text-[11px] font-bold uppercase tracking-[.2em] text-emerald-700">Catalog management</p><h1 class="brand-heading text-3xl font-bold tracking-tight text-slate-900">Products</h1><p class="mt-2 text-sm text-slate-500">Search, filter and manage product details, pricing, images and stock.</p></div><div class="flex flex-wrap gap-2"><a href="/admin/inventory" class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 hover:border-emerald-300">Manage inventory</a><a href="/admin/products/new" class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#174a34] px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-[#216744]">＋ Add product</a></div></section>
<div class="mb-5 grid grid-cols-2 gap-3 lg:grid-cols-4"><div class="rounded-2xl border border-slate-200/80 bg-white p-4"><p class="text-xs font-medium text-slate-500">Matching products</p><p class="mt-2 text-2xl font-bold text-slate-900"><%= pagination.total %></p></div><div class="rounded-2xl border border-slate-200/80 bg-white p-4"><p class="text-xs font-medium text-slate-500">Current page</p><p class="mt-2 text-2xl font-bold text-slate-900"><%= pagination.page %><span class="text-sm font-medium text-slate-400"> / <%= pagination.pages %></span></p></div><div class="rounded-2xl border border-slate-200/80 bg-white p-4"><p class="text-xs font-medium text-slate-500">Low stock shown</p><p class="mt-2 text-2xl font-bold text-amber-700"><%= products.filter(p=>Number(p.stock_quantity)>0 && Number(p.stock_quantity)<=5).length %></p></div><div class="rounded-2xl border border-slate-200/80 bg-white p-4"><p class="text-xs font-medium text-slate-500">Out of stock shown</p><p class="mt-2 text-2xl font-bold text-rose-700"><%= products.filter(p=>Number(p.stock_quantity)===0).length %></p></div></div>
<div class="mb-5 rounded-2xl border border-slate-200/80 bg-white p-4 sm:p-5"><form method="GET" action="/admin/products" class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-[minmax(220px,1.5fr)_minmax(160px,1fr)_minmax(160px,1fr)_auto_auto]"><label class="block"><span class="mb-1.5 block text-xs font-semibold text-slate-600">Search products</span><input type="search" name="search" value="<%= filters.search %>" placeholder="Name, SKU or product ID" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-3 text-sm outline-none transition focus:border-emerald-600 focus:bg-white focus:ring-3 focus:ring-emerald-100"></label><label class="block"><span class="mb-1.5 block text-xs font-semibold text-slate-600">Category</span><select name="category" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-sm outline-none focus:border-emerald-600 focus:bg-white"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c %>" <%= filters.category===c?'selected':'' %>><%= c %></option><% }) %></select></label><label class="block"><span class="mb-1.5 block text-xs font-semibold text-slate-600">Product status</span><select name="status" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-sm outline-none focus:border-emerald-600 focus:bg-white"><option value="">All statuses</option><option value="active" <%= filters.status==='active'?'selected':'' %>>Active</option><option value="inactive" <%= filters.status==='inactive'?'selected':'' %>>Inactive</option><option value="low" <%= filters.status==='low'?'selected':'' %>>Low stock (1–5)</option><option value="out" <%= filters.status==='out'?'selected':'' %>>Out of stock</option></select></label><div class="flex items-end"><button class="w-full rounded-xl bg-[#174a34] px-5 py-3 text-sm font-bold text-white hover:bg-[#216744]" type="submit">Apply filters</button></div><div class="flex items-end"><a href="/admin/products" class="w-full rounded-xl border border-slate-200 px-5 py-3 text-center text-sm font-semibold text-slate-600 hover:bg-slate-50">Reset</a></div></form></div>
<div class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm"><div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6"><div><h2 class="font-bold text-slate-900">Product catalogue</h2><p class="mt-1 text-xs text-slate-500">Showing <%= products.length ? ((pagination.page-1)*pagination.limit+1) : 0 %>–<%= (pagination.page-1)*pagination.limit+products.length %> of <%= pagination.total %> products</p></div><span class="rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-800">Page <%= pagination.page %> / <%= pagination.pages %></span></div><div class="table-wrap"><table class="data-table w-full text-left text-sm"><thead class="bg-slate-50/90 text-[10px] uppercase tracking-wider text-slate-500"><tr><th class="px-5 py-4 font-bold sm:px-6">Product</th><th class="px-4 py-4 font-bold">Price</th><th class="px-4 py-4 font-bold">Category / collection</th><th class="px-4 py-4 font-bold">Inventory</th><th class="px-5 py-4 text-right font-bold sm:px-6">Actions</th></tr></thead><tbody class="divide-y divide-slate-100"><% products.forEach(p => { %><tr class="transition hover:bg-slate-50/70"><td class="px-5 py-4 sm:px-6"><div class="flex min-w-[200px] items-center gap-3"><img src="<%= p.img || '/favicon.svg' %>" alt="<%= p.name %>" loading="lazy" onerror="this.onerror=null;this.src='/favicon.svg'" class="h-12 w-12 rounded-xl border border-slate-200 bg-slate-100 object-cover" /><div class="min-w-0"><p class="max-w-[230px] truncate font-bold text-slate-800"><%= p.name %></p><p class="mt-1 text-xs text-slate-400"><%= p.sku || ('Product #'+p.id) %></p><span class="mt-1 inline-flex rounded-full px-2 py-0.5 text-[10px] font-bold <%= p.is_active ? 'bg-emerald-50 text-emerald-800' : 'bg-slate-100 text-slate-500' %>"><%= p.is_active ? 'Active' : 'Inactive' %></span></div></div></td><td class="whitespace-nowrap px-4 py-4"><p class="font-bold text-slate-800">₹<%= Number(p.price||0).toLocaleString('en-IN') %></p><% if (p.old_price) { %><p class="mt-1 text-xs text-slate-400 line-through">₹<%= Number(p.old_price).toLocaleString('en-IN') %></p><% } %></td><td class="px-4 py-4"><span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600"><%= p.category || 'Uncategorized' %></span><p class="mt-1 text-[11px] text-slate-500"><%= ({'new-arrival':'New Arrival','most-loved':'Most Loved Pots','our-products':'Our Products'})[p.collection] || p.collection || 'Our Products' %></p></td><td class="px-4 py-4"><p class="font-bold <%= Number(p.stock_quantity)===0?'text-rose-700':Number(p.stock_quantity)<=5?'text-amber-700':'text-slate-800' %>"><%= Number(p.stock_quantity||0) %> units</p><span class="mt-1 inline-flex rounded-full px-2 py-1 text-[10px] font-bold <%= Number(p.stock_quantity)===0?'bg-rose-50 text-rose-700':Number(p.stock_quantity)<=5?'bg-amber-50 text-amber-800':'bg-emerald-50 text-emerald-800' %>"><%= Number(p.stock_quantity)===0?'Out of stock':Number(p.stock_quantity)<=5?'Low stock':'In stock' %></span></td><td class="whitespace-nowrap px-5 py-4 text-right sm:px-6"><a href="/admin/products/<%= p.id %>/edit" class="mr-1 inline-flex rounded-lg bg-blue-50 px-3 py-2 text-xs font-bold text-blue-700 hover:bg-blue-100">Edit</a><a href="/admin/products/<%= p.id %>/delete" class="inline-flex rounded-lg bg-rose-50 px-3 py-2 text-xs font-bold text-rose-700 hover:bg-rose-100" onclick="return confirm('Delete this product? This action cannot be undone.')">Delete</a></td></tr><% }) %></tbody></table></div>
<% if (!products.length) { %><div class="px-6 py-14 text-center"><div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 text-2xl">⌕</div><p class="font-bold text-slate-800">No matching products</p><p class="mt-1 text-sm text-slate-500">Try changing your search or filters, or add a new product.</p><a href="/admin/products/new" class="mt-4 inline-flex rounded-xl bg-[#174a34] px-4 py-2.5 text-sm font-bold text-white">＋ Add product</a></div><% } %>
<% if (pagination.pages > 1) { %><div class="flex flex-col gap-3 border-t border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6"><p class="text-xs text-slate-500">Page <%= pagination.page %> of <%= pagination.pages %></p><nav class="flex flex-wrap items-center gap-1.5" aria-label="Product pagination"><% const query = new URLSearchParams(); if(filters.search)query.set('search',filters.search);if(filters.category)query.set('category',filters.category);if(filters.status)query.set('status',filters.status); %><% if(pagination.page>1){query.set('page',pagination.page-1); %><a href="/admin/products?<%= query.toString() %>" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">← Previous</a><% } %><% for(let n=Math.max(1,pagination.page-2);n<=Math.min(pagination.pages,pagination.page+2);n++){query.set('page',n); %><a href="/admin/products?<%= query.toString() %>" class="rounded-lg px-3 py-2 text-xs font-bold <%= n===pagination.page?'bg-[#174a34] text-white':'border border-slate-200 text-slate-700 hover:bg-slate-50' %>"><%= n %></a><% } %><% if(pagination.page<pagination.pages){query.set('page',pagination.page+1); %><a href="/admin/products?<%= query.toString() %>" class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">Next →</a><% } %></nav></div><% } %></div>
