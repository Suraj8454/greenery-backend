<section class="mb-7"><p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Store / Catalog</p><h1 class="mt-2 text-3xl font-extrabold text-slate-900">Subcategories</h1><p class="mt-2 text-sm text-slate-500">Create subcategories under a parent category. Products can then be assigned to both.</p></section>
<div class="grid gap-6 lg:grid-cols-[360px_1fr]"><form method="POST" action="/admin/subcategories" class="h-fit rounded-2xl bg-white p-6 shadow-sm"><h2 class="mb-4 font-bold">Add subcategory</h2><label class="mb-1 block text-sm font-semibold">Parent category</label><select name="category_id" required class="mb-4 w-full rounded-xl border p-3"><option value="">Choose category</option><% cats.forEach(c=>{%><option value="<%=c.id%>"><%=c.name%></option><%})%></select><label class="mb-1 block text-sm font-semibold">Subcategory name</label><input name="name" required class="mb-4 w-full rounded-xl border p-3" placeholder="e.g. Ceramic Pots"><label class="mb-1 block text-sm font-semibold">URL slug (optional)</label><input name="slug" class="mb-4 w-full rounded-xl border p-3" placeholder="ceramic-pots"><label class="mb-1 block text-sm font-semibold">Sort order</label><input name="sort_order" type="number" value="0" class="mb-5 w-full rounded-xl border p-3"><button class="w-full rounded-xl bg-emerald-800 p-3 font-bold text-white">Create subcategory</button></form><div class="overflow-hidden rounded-2xl bg-white shadow-sm"><div class="border-b p-5 font-bold">Existing subcategories</div><% if(!rows.length){%><p class="p-6 text-sm text-slate-500">No subcategories yet.</p><%}%><% rows.forEach(row=>{%><div class="flex items-center justify-between gap-3 border-b p-4"><div><p class="font-semibold"><%=row.name%></p><p class="text-xs text-slate-500"><%=row.category_name%> · /<%=row.slug%></p></div><form method="POST" action="/admin/subcategories/<%=row.id%>/delete" onsubmit="return confirm('Delete this subcategory?')"><button class="rounded-lg bg-rose-50 px-3 py-2 text-xs font-bold text-rose-700">Delete</button></form></div><%})%></div></div>
