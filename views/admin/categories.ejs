<div class="flex flex-wrap items-end justify-between gap-4 mb-7">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[.16em] text-emerald-700">
      Store management
    </p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">
      Categories
    </h1>
    <p class="mt-2 text-sm text-slate-500">
      Manage your store categories, visibility and display order.
    </p>
  </div>

  <a
    href="/admin/categories/new"
    class="inline-flex items-center gap-2 rounded-xl bg-emerald-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-900"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5"/>
    </svg>
    Add category
  </a>
</div>

<%
  const totalCategories = categories.length;
  const activeCategories = categories.filter(item => Number(item.is_active) === 1).length;
  const hiddenCategories = totalCategories - activeCategories;
%>

<!-- Stats -->
<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-3">

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Total categories</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 text-slate-600">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 5.5A1.5 1.5 0 015.5 4h4A1.5 1.5 0 0111 5.5v4A1.5 1.5 0 019.5 11h-4A1.5 1.5 0 014 9.5v-4zM13 5.5A1.5 1.5 0 0114.5 4h4A1.5 1.5 0 0120 5.5v4a1.5 1.5 0 01-1.5 1.5h-4A1.5 1.5 0 0113 9.5v-4zM4 14.5A1.5 1.5 0 015.5 13h4a1.5 1.5 0 011.5 1.5v4A1.5 1.5 0 019.5 20h-4A1.5 1.5 0 014 18.5v-4zM13 14.5a1.5 1.5 0 011.5-1.5h4a1.5 1.5 0 011.5 1.5v4a1.5 1.5 0 01-1.5 1.5h-4a1.5 1.5 0 01-1.5-1.5v-4z"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-slate-900"><%= totalCategories %></p>
    <p class="mt-1 text-xs text-slate-500">All store categories</p>
  </div>

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Active categories</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-emerald-700"><%= activeCategories %></p>
    <p class="mt-1 text-xs text-slate-500">Visible on your store</p>
  </div>

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Hidden categories</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-amber-50 text-amber-700">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M10.6 10.6a2 2 0 002.8 2.8M9.9 5.1A10.5 10.5 0 0112 5c5 0 8.5 4.5 9 7-.2 1.1-.9 2.3-2 3.4M6.2 6.2C4.2 7.6 3.3 9.5 3 12c.5 2.5 4 7 9 7 1 0 2-.2 2.9-.5"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-amber-700"><%= hiddenCategories %></p>
    <p class="mt-1 text-xs text-slate-500">Not visible on your store</p>
  </div>

</div>



<!-- Categories table -->
<div class="overflow-hidden bg-white border shadow-sm rounded-2xl border-slate-200">

  <% if (categories.length) { %>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[760px] text-left text-sm">

        <thead class="text-xs font-semibold tracking-wide uppercase bg-slate-50 text-slate-500">
          <tr>
            <th class="px-5 py-4">Category</th>
            <th class="px-5 py-4">Slug</th>
            <th class="px-5 py-4">Sort order</th>
            <th class="px-5 py-4">Status</th>
            <th class="px-5 py-4 text-right">Actions</th>
          </tr>
        </thead>

        <tbody id="categoryTableBody" class="divide-y divide-slate-100">

          <% categories.forEach(item => { %>
            <tr data-category-row class="transition hover:bg-slate-50/70">

              <td class="px-5 py-4">
                <div class="flex items-center gap-3">
                  <% if (item.image) { %>
                    <img
                      src="<%= item.image %>"
                      class="object-cover border h-11 w-11 rounded-xl border-slate-100"
                      alt="<%= item.name %>"
                    >
                  <% } else { %>
                    <div class="flex items-center justify-center h-11 w-11 rounded-xl bg-emerald-50 text-emerald-700">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h16M7 15l3-4 3 3 4-6 3 7"/>
                      </svg>
                    </div>
                  <% } %>

                  <span class="font-semibold text-slate-900"><%= item.name %></span>
                </div>
              </td>

              <td class="px-5 py-4">
                <span class="px-2 py-1 text-xs rounded-md bg-slate-100 text-slate-600">
                  <%= item.slug %>
                </span>
              </td>

              <td class="px-5 py-4 text-slate-600">
                <%= item.sort_order || 0 %>
              </td>

              <td class="px-5 py-4">
                <% if (Number(item.is_active) === 1) { %>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
                    Active
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                    Hidden
                  </span>
                <% } %>
              </td>

              <td class="px-5 py-4">
                <div class="flex items-center justify-end gap-2">

                  <a
                    href="/admin/categories/<%= item.id %>/edit"
                    title="Edit category"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800"
                  >
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16 4 4 4M4 20l4-.8L19 8a2.1 2.1 0 00-3-3L5 16l-1 4z"/>
                    </svg>
                    Edit
                  </a>

                  <form
                    method="POST"
                    action="/admin/categories/<%= item.id %>/delete"
                    onsubmit="return confirm('Are you sure you want to delete this category?')"
                  >
                    <button
                      type="submit"
                      title="Delete category"
                      class="inline-flex items-center gap-1.5 rounded-lg border border-rose-100 px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-50"
                    >
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M10 11v6m4-6v6M5 7l1 13h12l1-13M9 7V4h6v3"/>
                      </svg>
                      Delete
                    </button>
                  </form>

                </div>
              </td>
            </tr>
          <% }) %>

        </tbody>
      </table>
    </div>

    <!-- Search no results -->
    <div id="categoryNoResults" class="hidden px-6 text-center py-14">
      <div class="flex items-center justify-center w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-500">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="7"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="m16 16 4 4"/>
        </svg>
      </div>
      <p class="mt-3 text-sm font-semibold text-slate-800">No matching categories found</p>
      <p class="mt-1 text-sm text-slate-500">Try another category name or slug.</p>
    </div>

  <% } else { %>

    <!-- Empty database state -->
    <div class="px-6 py-16 text-center">
      <div class="flex items-center justify-center mx-auto h-14 w-14 rounded-2xl bg-emerald-50 text-emerald-700">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 5h16v14H4zM8 9h8M8 13h5"/>
        </svg>
      </div>
      <h3 class="mt-4 text-base font-semibold text-slate-900">No categories yet</h3>
      <p class="mt-1 text-sm text-slate-500">Create your first category to organize your products.</p>
      <a
        href="/admin/categories/new"
        class="mt-5 inline-flex items-center gap-2 rounded-xl bg-emerald-800 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-900"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5"/>
        </svg>
        Add first category
      </a>
    </div>

  <% } %>

</div>

<script>
  (() => {
    const searchInput = document.getElementById("categorySearch");
    const rows = document.querySelectorAll("[data-category-row]");
    const countElement = document.getElementById("categoryCount");
    const noResults = document.getElementById("categoryNoResults");

    if (!searchInput) return;

    searchInput.addEventListener("input", (event) => {
      const query = event.target.value.trim().toLowerCase();
      let visibleCount = 0;

      rows.forEach((row) => {
        const matches = row.textContent.toLowerCase().includes(query);

        row.hidden = !matches;

        if (matches) visibleCount++;
      });

      if (countElement) {
        countElement.textContent = visibleCount;
      }

      if (noResults) {
        noResults.classList.toggle(
          "hidden",
          visibleCount !== 0 || query === ""
        );
      }
    });
  })();
</script>
