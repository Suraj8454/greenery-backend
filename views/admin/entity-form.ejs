<% const isEdit=!!record; const action=base+(isEdit?'/'+record.id:''); %>
<div class="mb-7 flex flex-wrap items-end justify-between gap-4"><div><a href="<%=base%>" class="text-sm font-medium text-emerald-700 hover:text-emerald-900">← Back to list</a><p class="mt-5 text-xs font-semibold uppercase tracking-[.16em] text-emerald-700"><%=eyebrow%></p><h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900"><%=isEdit?'Edit':'Add new'%> <%=entity%></h1><p class="mt-2 text-sm text-slate-500">Keep your storefront content clear, consistent and up to date.</p></div><span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-medium text-slate-600"><%=isEdit?'Record #'+record.id:'New record'%></span></div>
<form action="<%=action%>" method="POST" enctype="multipart/form-data" class="space-y-6">
<div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="mb-5"><h2 class="text-base font-semibold text-slate-900">Content details</h2><p class="mt-1 text-sm text-slate-500">Enter the information shown on your website.</p></div><div class="grid gap-5 md:grid-cols-2">
<% fields.forEach(f=>{ const val=(record&&record[f.name]!==undefined)?record[f.name]: (f.value||''); %><div class="<%=f.full?'md:col-span-2':''%>"><label class="mb-2 block text-sm font-medium text-slate-700"><%=f.label%><%=f.required?' *':''%></label><% if(f.type==='textarea'){%><textarea name="<%=f.name%>" rows="<%=f.rows||4%>" <%=f.required?'required':''%> placeholder="<%=f.placeholder||''%>" class="admin-field w-full"><%=val||''%></textarea><%}else if(f.type==='select'){%><select name="<%=f.name%>" class="admin-field w-full"><%f.options.forEach(o=>{%><option value="<%=o.value%>" <%=String(val)===String(o.value)?'selected':''%>><%=o.label%></option><%})%></select><%}else if(f.type==='file'){%><%if(val){%><input type="hidden" name="<%=f.keep||f.name%>" value="<%=val%>"><div class="mb-2 flex items-center gap-3"><img src="<%=val%>" class="h-14 w-20 rounded-lg object-cover" alt="Current image"><span class="text-xs text-slate-500">Current image</span></div><%}%><input type="file" name="<%=f.name%>" accept="image/*" class="admin-field w-full"><%}else{%><input type="<%=f.type||'text'%>" name="<%=f.name%>" value="<%=val??''%>" <%=f.required?'required':''%> placeholder="<%=f.placeholder||''%>" class="admin-field w-full"><%}%><%if(f.help){%><p class="mt-1.5 text-xs text-slate-500"><%=f.help%></p><%}%></div><%})%>
</div></div><div class="flex flex-wrap items-center justify-end gap-3"><a href="<%=base%>" class="rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a><button class="rounded-xl bg-emerald-800 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-900">Save <%=entity%></button></div></form>