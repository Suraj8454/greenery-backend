<section class="mb-7"><a href="/admin/products" class="mb-4 inline-flex items-center gap-2 text-sm font-semibold text-emerald-700">← Back to products</a><p class="mb-2 text-xs font-bold uppercase tracking-[.18em] text-emerald-700">Catalog management</p><h1 class="brand-heading text-3xl font-extrabold text-slate-900"><%= product ? 'Edit product' : 'Add a product' %></h1><p class="mt-2 text-sm text-slate-500">Manage product details, gallery, colour options, collections, visibility and stock.</p></section>
<form method="POST" enctype="multipart/form-data" action="<%= product ? `/admin/products/${product.id}` : '/admin/products' %>" class="max-w-5xl rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200/70 sm:p-8">
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2"><label class="mb-2 block text-sm font-semibold">Product name *</label><input name="name" value="<%= product?.name || '' %>" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
    <div><label class="mb-2 block text-sm font-semibold">Price (₹) *</label><input name="price" type="number" min="0" step="0.01" value="<%= product?.price || '' %>" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
    <div><label class="mb-2 block text-sm font-semibold">Old price (₹)</label><input name="oldPrice" type="number" min="0" step="0.01" value="<%= product?.old_price || '' %>" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
    <div><label class="mb-2 block text-sm font-semibold">Category *</label><select id="categorySelect" name="category_id" required class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><option value="">Choose category</option><% (categories || []).forEach(c => { %><option value="<%= c.id %>" <%= Number(product?.category_id)===Number(c.id) || (!product?.category_id && product?.category===c.name) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
    <div><label class="mb-2 block text-sm font-semibold">Subcategory</label><select id="subcategorySelect" name="subcategory_id" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><option value="">Choose subcategory (optional)</option></select></div>
    <div><label class="mb-2 block text-sm font-semibold">Homepage collection</label><select name="collection" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><% const collection=product?.collection || 'our-products'; %><option value="new-arrival" <%= collection==='new-arrival'?'selected':'' %>>New Arrival</option><option value="most-loved" <%= collection==='most-loved'?'selected':'' %>>Most Loved Pots</option><option value="our-products" <%= collection==='our-products'?'selected':'' %>>Our Products</option></select></div>
    <div><label class="mb-2 block text-sm font-semibold">SKU / product code</label><input name="sku" value="<%= product?.sku || '' %>" placeholder="e.g. CG-POT-001" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
    <div><label class="mb-2 block text-sm font-semibold">Stock quantity</label><input name="stock_quantity" type="number" min="0" value="<%= product?.stock_quantity || 0 %>" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
    <div><label class="mb-2 block text-sm font-semibold">Tag / badge</label><input name="tag" value="<%= product?.tag || '' %>" placeholder="Bestseller, New, Sale" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"></div>
    <div><label class="mb-2 block text-sm font-semibold">Visibility</label><select name="is_active" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><option value="1" <%= !product || Number(product.is_active)!==0?'selected':'' %>>Active — show on website</option><option value="0" <%= product && Number(product.is_active)===0?'selected':'' %>>Inactive — hide from website</option></select></div>
    <div class="sm:col-span-2 rounded-2xl border border-slate-200 p-5"><div class="flex flex-wrap items-center justify-between gap-3"><div><label class="block text-sm font-bold">Product colours</label><p class="mt-1 text-xs text-slate-500">Add as many colours as you need. Choose each colour from the colour picker.</p></div><button type="button" id="addColour" class="rounded-xl bg-emerald-50 px-4 py-2 text-sm font-bold text-emerald-800 hover:bg-emerald-100">+ Add colour</button></div><div id="colourRows" class="mt-4 space-y-3"></div><input type="hidden" name="colors" id="colorsJson" value="[]"></div>
    <div class="sm:col-span-2 rounded-2xl border border-slate-200 p-5"><div class="flex flex-wrap items-center justify-between gap-3"><div><label class="block text-sm font-bold">Product image gallery</label><p class="mt-1 text-xs text-slate-500">Select 4–5 images together, or add more in separate selections. Remove unwanted images and use arrows to set image order. Image 1 is the main product image.</p></div><span id="imageCount" class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800">0 images</span></div><input id="imagePicker" name="images" type="file" multiple accept="image/png,image/jpeg,image/webp,image/gif" class="mt-4 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm file:mr-4 file:rounded-lg file:border-0 file:bg-emerald-50 file:px-3 file:py-2 file:font-bold file:text-emerald-800"><input type="hidden" name="imageOrder" id="imageOrder" value="[]"><div id="imageGalleryPreview" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4"></div><p class="mt-3 text-xs text-slate-500">Up to 8 images total, maximum 5 MB each.</p></div>
    <div class="sm:col-span-2"><label class="mb-2 block text-sm font-semibold">Description</label><textarea name="desc" rows="4" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><%= product?.desc || product?.description || '' %></textarea></div>
    <div><label class="mb-2 block text-sm font-semibold">Features (one per line)</label><textarea name="features" rows="4" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><%= product?.features || '' %></textarea></div>
    <div><label class="mb-2 block text-sm font-semibold">Benefits (one per line)</label><textarea name="benefits" rows="4" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><%= product?.benefits || '' %></textarea></div>
    <div class="sm:col-span-2"><label class="mb-2 block text-sm font-semibold">How to use / care instructions</label><textarea name="how_to_use" rows="4" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm"><%= product?.how_to_use || '' %></textarea></div>
  </div><div class="mt-8 flex flex-col-reverse gap-3 border-t border-slate-100 pt-6 sm:flex-row sm:justify-end"><a href="/admin/products" class="rounded-xl border border-slate-200 px-5 py-3 text-center text-sm font-bold text-slate-600">Cancel</a><button class="rounded-xl bg-[#174a34] px-6 py-3 text-sm font-bold text-white">Save product</button></div>
</form>

<script>
(() => {
  const categorySelect = document.getElementById('categorySelect');
  const subcategorySelect = document.getElementById('subcategorySelect');
  const subcategoryData = <%- JSON.stringify(subcategories || []) %>;
  const selectedSubcategory = '<%= product?.subcategory_id || "" %>';
  const refreshSubcategories = () => { const id=categorySelect.value; const matches=subcategoryData.filter(s=>String(s.category_id)===String(id)); subcategorySelect.innerHTML='<option value="">Choose subcategory (optional)</option>'+matches.map(s=>`<option value="${s.id}">${String(s.name).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}</option>`).join(''); if(matches.some(s=>String(s.id)===String(selectedSubcategory))) subcategorySelect.value=selectedSubcategory; };
  categorySelect.addEventListener('change',()=>{ subcategorySelect.value=''; refreshSubcategories(); }); refreshSubcategories();
  const picker = document.getElementById('imagePicker');
  const gallery = document.getElementById('imageGalleryPreview');
  const orderInput = document.getElementById('imageOrder');
  const count = document.getElementById('imageCount');
  const form = document.querySelector('form[enctype="multipart/form-data"]');
  const initialImages = <%- JSON.stringify(product?.images || (product?.img ? [product.img] : [])) %>;
  const initialColors = <%- JSON.stringify(product?.colors || []) %>;
  let entries = (Array.isArray(initialImages) ? initialImages : []).filter(Boolean).map(url => ({ type: 'existing', value: url }));
  let colours = [];
  const normaliseColor = (c) => {
    if (c && typeof c === 'object') return { name: c.name || 'Colour', hex: /^#[0-9a-f]{6}$/i.test(c.hex || '') ? c.hex : '#2d6a4f' };
    const [name, hex] = String(c || '').split(':');
    return { name: name || 'Colour', hex: /^#[0-9a-f]{6}$/i.test(hex || '') ? hex : '#2d6a4f' };
  };
  const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const setPickerFiles = () => { const dt = new DataTransfer(); entries.filter(e => e.type === 'new').forEach(e => dt.items.add(e.file)); picker.files = dt.files; };
  const renderGallery = () => {
    gallery.innerHTML = ''; count.textContent = `${entries.length} image${entries.length === 1 ? '' : 's'}`;
    entries.forEach((entry, index) => {
      const card = document.createElement('div'); card.className = 'overflow-hidden rounded-xl border border-slate-200 bg-white';
      const src = entry.type === 'existing' ? entry.value : URL.createObjectURL(entry.file);
      card.innerHTML = `<div class="relative aspect-square bg-slate-100"><img src="${escapeHtml(src)}" alt="Product image ${index+1}" class="h-full w-full object-cover"><span class="absolute left-2 top-2 rounded-full bg-slate-900/80 px-2 py-1 text-[10px] font-bold text-white">${index === 0 ? 'MAIN IMAGE' : `IMAGE ${index+1}`}</span></div><div class="flex items-center justify-between gap-1 p-2"><button type="button" data-move="-1" class="rounded-lg border px-2 py-1 text-xs font-bold" ${index === 0 ? 'disabled' : ''} aria-label="Move image earlier">↑</button><button type="button" data-move="1" class="rounded-lg border px-2 py-1 text-xs font-bold" ${index === entries.length-1 ? 'disabled' : ''} aria-label="Move image later">↓</button><button type="button" data-remove="1" class="rounded-lg bg-rose-50 px-2 py-1 text-xs font-bold text-rose-700">Remove</button></div>`;
      card.querySelector('[data-move="-1"]').addEventListener('click', () => { [entries[index-1], entries[index]] = [entries[index], entries[index-1]]; renderGallery(); });
      card.querySelector('[data-move="1"]').addEventListener('click', () => { [entries[index+1], entries[index]] = [entries[index], entries[index+1]]; renderGallery(); });
      card.querySelector('[data-remove]').addEventListener('click', () => { entries.splice(index,1); setPickerFiles(); renderGallery(); });
      gallery.appendChild(card);
    });
    orderInput.value = JSON.stringify(entries.map(e => e.type === 'existing' ? {type:'existing', value:e.value} : {type:'new', index: entries.filter((x,i) => x.type === 'new' && i < entries.indexOf(e)).length}));
  };
  picker.addEventListener('change', () => {
    const incoming = Array.from(picker.files || []);
    for (const file of incoming) {
      if (entries.length >= 8) { alert('Maximum 8 product images allowed.'); break; }
      if (file.size > 5 * 1024 * 1024) { alert(`${file.name} is larger than 5 MB and was skipped.`); continue; }
      entries.push({type:'new', file});
    }
    setPickerFiles(); renderGallery();
  });
  const colourRows = document.getElementById('colourRows');
  const coloursJson = document.getElementById('colorsJson');
  const renderColours = () => {
    colourRows.innerHTML = '';
    colours.forEach((colour, index) => {
      const row = document.createElement('div'); row.className = 'flex flex-wrap items-center gap-3 rounded-xl bg-slate-50 p-3';
      row.innerHTML = `<input type="color" value="${colour.hex}" aria-label="Colour picker" class="h-11 w-14 cursor-pointer rounded-lg border border-slate-200 bg-white p-1"><input type="text" value="${escapeHtml(colour.name)}" placeholder="Colour name (e.g. Forest Green)" class="min-w-[180px] flex-1 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm"><span class="rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-semibold">${escapeHtml(colour.hex)}</span><button type="button" class="rounded-xl bg-rose-50 px-3 py-2 text-xs font-bold text-rose-700">Remove</button>`;
      const inputs = row.querySelectorAll('input'); inputs[0].addEventListener('input', e => { colours[index].hex = e.target.value; row.querySelector('span').textContent = e.target.value; coloursJson.value = JSON.stringify(colours); }); inputs[1].addEventListener('input', e => { colours[index].name = e.target.value; coloursJson.value = JSON.stringify(colours); });
      row.querySelector('button').addEventListener('click', () => { colours.splice(index,1); renderColours(); }); colourRows.appendChild(row);
    });
    coloursJson.value = JSON.stringify(colours);
  };
  document.getElementById('addColour').addEventListener('click', () => { if (colours.length >= 20) return alert('Maximum 20 colour options allowed.'); colours.push({name:`Colour ${colours.length+1}`, hex:'#2d6a4f'}); renderColours(); });
  colours = (Array.isArray(initialColors) ? initialColors : []).map(normaliseColor);
  if (!colours.length) colours = [{name:'Forest Green',hex:'#2d6a4f'}];
  renderColours(); renderGallery();
  form.addEventListener('submit', e => {
    if (!entries.length) { e.preventDefault(); alert('Please add at least one product image.'); return; }
    setPickerFiles();
    orderInput.value = JSON.stringify(entries.map(e => e.type === 'existing' ? {type:'existing', value:e.value} : {type:'new', index: entries.filter((x,i) => x.type === 'new' && i < entries.indexOf(e)).length}));
    coloursJson.value = JSON.stringify(colours.filter(c => c.name.trim()));
  });
})();
</script>
