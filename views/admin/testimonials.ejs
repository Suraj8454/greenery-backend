<div class="flex flex-wrap items-end justify-between gap-4 mb-7">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[.16em] text-emerald-700">
      Store management
    </p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">
      Testimonials
    </h1>
    <p class="mt-2 text-sm text-slate-500">
      Manage customer stories, product feedback and ratings.
    </p>
  </div>

  <a
    href="/admin/testimonials/new"
    class="inline-flex items-center gap-2 rounded-xl bg-emerald-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-900"
  >
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5"/>
    </svg>
    Add testimonial
  </a>
</div>

<%
  const totalTestimonials = testimonials.length;
  const validRatings = testimonials
    .map(item => Number(item.rating))
    .filter(rating => Number.isFinite(rating) && rating >= 1 && rating <= 5);

  const averageRating = validRatings.length
    ? (validRatings.reduce((sum, rating) => sum + rating, 0) / validRatings.length).toFixed(1)
    : '0.0';

  const fiveStarReviews = validRatings.filter(rating => rating === 5).length;
%>

<!-- Stats -->
<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-3">

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Total testimonials</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-slate-100 text-slate-600">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h6m-8 8l-1-4a8 8 0 118 4H5z"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-slate-900"><%= totalTestimonials %></p>
    <p class="mt-1 text-xs text-slate-500">All customer reviews</p>
  </div>

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Average rating</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-amber-50 text-amber-600">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3z"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-amber-600"><%= averageRating %><span class="text-lg text-slate-400"> / 5</span></p>
    <p class="mt-1 text-xs text-slate-500">Based on available ratings</p>
  </div>

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">5-star reviews</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-emerald-700"><%= fiveStarReviews %></p>
    <p class="mt-1 text-xs text-slate-500">Highest-rated reviews</p>
  </div>

</div>

<!-- Search toolbar -->


<!-- Testimonials table -->
<div class="overflow-hidden bg-white border shadow-sm rounded-2xl border-slate-200">

  <% if (testimonials.length) { %>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[850px] text-left text-sm">

        <thead class="text-xs font-semibold tracking-wide uppercase bg-slate-50 text-slate-500">
          <tr>
            <th class="px-5 py-4">Customer</th>
            <th class="px-5 py-4">Product</th>
            <th class="px-5 py-4">Rating</th>
            <th class="px-5 py-4">Review</th>
            <th class="px-5 py-4 text-right">Actions</th>
          </tr>
        </thead>

        <tbody id="testimonialTableBody" class="divide-y divide-slate-100">

          <% testimonials.forEach(item => { %>
            <tr data-testimonial-row class="transition hover:bg-slate-50/70">

              <!-- Customer -->
              <td class="px-5 py-4">
                <div class="flex items-center gap-3">
                  <div class="flex items-center justify-center w-10 h-10 text-sm font-semibold uppercase rounded-full shrink-0 bg-emerald-50 text-emerald-800">
                    <%= (item.name || 'C').trim().charAt(0) %>
                  </div>
                  <span class="font-semibold text-slate-900"><%= item.name %></span>
                </div>
              </td>

              <!-- Product -->
              <td class="px-5 py-4">
                <span class="text-slate-600">
                  <%= item.product || '—' %>
                </span>
              </td>

              <!-- Rating -->
              <td class="px-5 py-4">
                <div class="inline-flex items-center gap-2 rounded-lg bg-amber-50 px-2.5 py-1.5">
                  <svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 1.5l2.6 5.3 5.9.9-4.25 4.1 1 5.8L10 14.85l-5.25 2.75 1-5.8L1.5 7.7l5.9-.9L10 1.5z"/>
                  </svg>
                  <span class="text-xs font-semibold text-amber-800">
                    <%= item.rating %> / 5
                  </span>
                </div>
              </td>

              <!-- Review -->
              <td class="max-w-xs px-5 py-4">
                <p class="line-clamp-2 text-slate-500" title="<%= item.review || '' %>">
                  <%= String(item.review || '').slice(0, 120) %><%= String(item.review || '').length > 120 ? '...' : '' %>
                </p>
              </td>

              <!-- Actions -->
              <td class="px-5 py-4">
                <div class="flex items-center justify-end gap-2">

                  <a
                    href="/admin/testimonials/<%= item.id %>/edit"
                    title="Edit testimonial"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-800"
                  >
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16 4 4 4M4 20l4-.8L19 8a2.1 2.1 0 00-3-3L5 16l-1 4z"/>
                    </svg>
                    Edit
                  </a>

                  <form
                    method="POST"
                    action="/admin/testimonials/<%= item.id %>/delete"
                    onsubmit="return confirm('Are you sure you want to delete this testimonial?')"
                  >
                    <button
                      type="submit"
                      title="Delete testimonial"
                      class="inline-flex items-center gap-1.5 rounded-lg border border-rose-100 px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-50"
                    >
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M10 11v6m4-6v6M5 7l1 13h12l1-13M9 7V4h6v3"/>
                      </svg>
                      Delete
                    </button>
                  </form>

                </div>
              </td>

            </tr>
          <% }) %>

        </tbody>
      </table>
    </div>

    <!-- No search results -->
    <div id="testimonialNoResults" class="hidden px-6 text-center py-14">
      <div class="flex items-center justify-center w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-500">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="7"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="m16 16 4 4"/>
        </svg>
      </div>
      <p class="mt-3 text-sm font-semibold text-slate-800">No matching testimonials found</p>
      <p class="mt-1 text-sm text-slate-500">Try searching with another customer or product name.</p>
    </div>

  <% } else { %>

    <!-- Empty state -->
    <div class="px-6 py-16 text-center">
      <div class="flex items-center justify-center mx-auto h-14 w-14 rounded-2xl bg-emerald-50 text-emerald-700">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h6m-8 8l-1-4a8 8 0 118 4H5z"/>
        </svg>
      </div>
      <h3 class="mt-4 text-base font-semibold text-slate-900">No testimonials yet</h3>
      <p class="mt-1 text-sm text-slate-500">Add your first customer testimonial to get started.</p>
      <a
        href="/admin/testimonials/new"
        class="mt-5 inline-flex items-center gap-2 rounded-xl bg-emerald-800 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-900"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5"/>
        </svg>
        Add first testimonial
      </a>
    </div>

  <% } %>

</div>

<script>
  (() => {
    const searchInput = document.getElementById('testimonialSearch');
    const rows = document.querySelectorAll('[data-testimonial-row]');
    const countElement = document.getElementById('testimonialCount');
    const noResults = document.getElementById('testimonialNoResults');

    if (!searchInput) return;

    searchInput.addEventListener('input', (event) => {
      const query = event.target.value.trim().toLowerCase();
      let visibleCount = 0;

      rows.forEach((row) => {
        const matches = row.textContent.toLowerCase().includes(query);

        row.hidden = !matches;

        if (matches) visibleCount++;
      });

      if (countElement) {
        countElement.textContent = visibleCount;
      }

      if (noResults) {
        noResults.classList.toggle(
          'hidden',
          visibleCount !== 0 || query === ''
        );
      }
    });
  })();
</script>
