<section class="mb-7">
  <p class="mb-2 text-xs font-bold uppercase tracking-[.18em] text-emerald-700">
    Customer directory
  </p>
  <h1 class="text-3xl font-extrabold tracking-tight brand-heading text-slate-900">
    Users
  </h1>
  <p class="mt-2 text-sm text-slate-500">
    View customer contact details and account creation dates.
  </p>
</section>

<% if (notice) { %>
  <div class="flex items-center gap-3 px-4 py-3 mb-5 text-sm font-semibold border rounded-xl border-emerald-100 bg-emerald-50 text-emerald-800">
    <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12l4 4L19 6"/>
    </svg>
    <%= notice %>
  </div>
<% } %>

<%
  const totalUsers = users.length;

  const usersWithEmail = users.filter(u => u.email).length;

  const usersWithPhone = users.filter(u => u.phone).length;

  const formatDate = (date) => {
    if (!date) return '—';

    const parsedDate = new Date(date);

    return Number.isNaN(parsedDate.getTime())
      ? '—'
      : parsedDate.toLocaleDateString('en-IN', {
          day: '2-digit',
          month: 'short',
          year: 'numeric'
        });
  };
%>

<!-- Stats -->
<div class="grid grid-cols-1 gap-4 mb-6 sm:grid-cols-3">

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Total customers</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2m6-10a4 4 0 100-8 4 4 0 000 8zm10 10v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-slate-900"><%= totalUsers %></p>
    <p class="mt-1 text-xs text-slate-500">Registered customer accounts</p>
  </div>

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Email available</p>
      <div class="flex items-center justify-center w-10 h-10 text-blue-700 rounded-xl bg-blue-50">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-blue-700"><%= usersWithEmail %></p>
    <p class="mt-1 text-xs text-slate-500">Customers with email addresses</p>
  </div>

  <div class="p-5 bg-white border shadow-sm rounded-2xl border-slate-200">
    <div class="flex items-center justify-between">
      <p class="text-sm font-medium text-slate-500">Phone available</p>
      <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-amber-50 text-amber-700">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 3h4l2 5-3 2a16 16 0 006 6l2-3 5 2v4a2 2 0 01-2 2A18 18 0 013 5a2 2 0 012-2z"/>
        </svg>
      </div>
    </div>
    <p class="mt-3 text-3xl font-semibold text-amber-700"><%= usersWithPhone %></p>
    <p class="mt-1 text-xs text-slate-500">Customers with phone numbers</p>
  </div>

</div>

<!-- Customer list -->
<div class="overflow-hidden bg-white border shadow-sm rounded-2xl border-slate-200">

  <!-- Toolbar -->
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 border-b border-slate-100 sm:px-6">
    <div>
      <h2 class="font-bold text-slate-900">Registered customers</h2>
      <p class="mt-1 text-xs text-slate-500">
        Customer accounts in your store
      </p>
    </div>

    <span class="rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700">
      <strong id="userCount"><%= totalUsers %></strong> users
    </span>
  </div>

  <!-- Search -->
  
  <% if (users.length) { %>

    <!-- Table -->
    <div class="overflow-x-auto table-wrap">
      <table class="data-table w-full min-w-[850px] text-left text-sm">

        <thead class="bg-slate-50 text-[11px] uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-5 py-4 font-bold sm:px-6">Customer</th>
            <th class="px-4 py-4 font-bold">Email</th>
            <th class="px-4 py-4 font-bold">Phone</th>
            <th class="px-5 py-4 font-bold sm:px-6">Joined</th>
            <th class="px-5 py-4 font-bold text-right sm:px-6">Action</th>
          </tr>
        </thead>

        <tbody id="userTableBody" class="divide-y divide-slate-100">

          <% users.forEach(u => { %>
            <tr data-user-row class="transition hover:bg-slate-50/70">

              <!-- Customer -->
              <td class="px-5 py-4 sm:px-6">
                <div class="flex items-center gap-3">
                  <div class="flex items-center justify-center w-10 h-10 text-sm font-extrabold rounded-full shrink-0 bg-emerald-50 text-emerald-800">
                    <%= (u.name || 'U').charAt(0).toUpperCase() %>
                  </div>

                  <div>
                    <p class="font-bold text-slate-800">
                      <%= u.name || 'Unknown user' %>
                    </p>
                    <p class="mt-1 text-xs text-slate-400">
                      ID: <%= u.id %>
                    </p>
                  </div>
                </div>
              </td>

              <!-- Email -->
              <td class="px-4 py-4 text-slate-600">
                <%= u.email || '—' %>
              </td>

              <!-- Phone -->
              <td class="px-4 py-4 text-slate-600">
                <%= u.phone || '—' %>
              </td>

              <!-- Joined -->
              <td class="px-5 py-4 text-slate-500 sm:px-6">
                <%= formatDate(u.created_at) %>
              </td>

              <!-- Delete -->
              <td class="px-5 py-4 text-right sm:px-6">
                <form
                  method="POST"
                  action="/admin/users/<%= u.id %>/delete"
                  onsubmit="return confirm('Delete this customer account? Customers with orders are protected to preserve order history.')"
                >
                  <button
                    type="submit"
                    title="Delete customer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-rose-100 bg-rose-50 px-3 py-2 text-xs font-bold text-rose-700 transition hover:bg-rose-100"
                  >
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M10 11v6m4-6v6M5 7l1 13h12l1-13M9 7V4h6v3"/>
                    </svg>
                    Delete
                  </button>
                </form>
              </td>

            </tr>
          <% }) %>

        </tbody>
      </table>
    </div>

    <!-- No search results -->
    <div id="userNoResults" class="hidden px-6 text-center py-14">
      <div class="flex items-center justify-center w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-500">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="7"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="m16 16 4 4"/>
        </svg>
      </div>
      <p class="mt-3 text-sm font-semibold text-slate-800">
        No matching customers found
      </p>
      <p class="mt-1 text-sm text-slate-500">
        Try another name, email or phone number.
      </p>
    </div>

  <% } else { %>

    <!-- Empty state -->
    <div class="px-6 py-16 text-center">
      <div class="flex items-center justify-center mx-auto h-14 w-14 rounded-2xl bg-emerald-50 text-emerald-700">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2m6-10a4 4 0 100-8 4 4 0 000 8zm10 10v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
        </svg>
      </div>

      <h3 class="mt-4 text-base font-semibold text-slate-900">
        No customers yet
      </h3>
      <p class="mt-1 text-sm text-slate-500">
        Registered customers will appear here.
      </p>
    </div>

  <% } %>

</div>

<script>
  (() => {
    const searchInput = document.getElementById('userSearch');
    const rows = document.querySelectorAll('[data-user-row]');
    const countElement = document.getElementById('userCount');
    const noResults = document.getElementById('userNoResults');

    if (!searchInput) return;

    searchInput.addEventListener('input', (event) => {
      const query = event.target.value.trim().toLowerCase();
      let visibleCount = 0;

      rows.forEach((row) => {
        const matches = row.textContent.toLowerCase().includes(query);

        row.hidden = !matches;

        if (matches) visibleCount++;
      });

      if (countElement) {
        countElement.textContent = visibleCount;
      }

      if (noResults) {
        noResults.classList.toggle(
          'hidden',
          visibleCount !== 0 || query === ''
        );
      }
    });
  })();
</script>
