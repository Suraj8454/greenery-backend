<% if (typeof querySaved !== 'undefined' && querySaved) { %><div class="mb-4 rounded-xl bg-emerald-50 p-3 text-sm font-semibold text-emerald-800">Order updated and timeline entry added.</div><% } %><section class="mb-6 flex flex-wrap items-start justify-between gap-4"><div><a href="/admin/orders" class="text-sm font-bold text-emerald-800">← All orders</a><p class="mt-4 text-xs font-bold uppercase tracking-widest text-emerald-700">Order detail</p><h1 class="mt-1 text-3xl font-extrabold">#CG-<%=String(order.id).padStart(6,'0')%></h1><p class="mt-2 text-sm text-slate-500">Placed <%=new Date(order.created_at).toLocaleString('en-IN')%></p></div><a href="/admin/orders/<%=order.id%>/invoice.pdf" class="rounded-xl bg-[#174a34] px-4 py-3 text-sm font-bold text-white">↓ Download PDF invoice</a></section>
<div class="grid gap-5 xl:grid-cols-[1.3fr_.7fr]"><div class="space-y-5"><section class="rounded-2xl bg-white p-5 ring-1 ring-slate-200"><h2 class="mb-4 text-lg font-extrabold">Ordered items</h2><div class="divide-y"><% items.forEach(i=>{ %><div class="flex items-center gap-4 py-4"><img src="<%=i.image||i.img||''%>" alt="<%=i.product_name%>" class="h-16 w-16 rounded-xl border object-cover" onerror="this.style.display='none'"><div class="min-w-0 flex-1"><p class="font-bold"><%=i.product_name%></p><p class="mt-1 text-xs text-slate-500">Qty <%=i.qty%> · Unit price ₹<%=Number(i.price).toFixed(2)%><% if(i.selected_color){let selected=i.selected_color;try{selected=JSON.parse(i.selected_color)}catch{} %> · Colour <%=typeof selected==='object'?selected.name:selected%><%}%></p></div><p class="font-extrabold">₹<%=(Number(i.price)*Number(i.qty)).toFixed(2)%></p></div><% }) %></div><div class="ml-auto max-w-xs space-y-2 border-t pt-4 text-sm"><p class="flex justify-between"><span>Subtotal</span><b>₹<%=Number(order.subtotal||0).toFixed(2)%></b></p><p class="flex justify-between"><span>Shipping</span><b>₹<%=Number(order.shipping||0).toFixed(2)%></b></p><p class="flex justify-between"><span>Discount <%=order.promo_code?'('+order.promo_code+')':''%></span><b>−₹<%=Number(order.discount||0).toFixed(2)%></b></p><p class="flex justify-between border-t pt-3 text-base"><span class="font-bold">Grand total</span><b class="text-emerald-800">₹<%=Number(order.total||0).toFixed(2)%></b></p></div></section>
<section class="rounded-2xl bg-white p-5 ring-1 ring-slate-200"><h2 class="mb-4 text-lg font-extrabold">Customer & delivery</h2><div class="grid gap-4 sm:grid-cols-2"><div><p class="text-xs uppercase text-slate-400">Customer</p><p class="mt-1 font-bold"><%=order.customer_name||'Customer'%></p><p class="text-sm text-slate-600"><%=order.customer_email||order.user_email||order.email||'No email'%></p><p class="text-sm text-slate-600"><%=order.phone||order.user_phone||'No phone'%></p></div><div><p class="text-xs uppercase text-slate-400">Delivery address</p><p class="mt-1 text-sm leading-6"><%=order.address||''%><br><%=order.city||''%> <%=order.pincode||''%></p></div></div></section>
<section class="rounded-2xl bg-white p-5 ring-1 ring-slate-200"><h2 class="mb-4 text-lg font-extrabold">Order timeline</h2><div class="space-y-4"><% timeline.forEach(t=>{ %><div class="flex gap-3"><span class="mt-1 h-3 w-3 rounded-full bg-emerald-600 ring-4 ring-emerald-50"></span><div><p class="font-bold"><%=t.status%></p><p class="text-xs text-slate-500"><%=new Date(t.created_at).toLocaleString('en-IN')%></p><% if(t.note){%><p class="mt-1 text-sm"><%=t.note%></p><%}%></div></div><% }) %><% if(!timeline.length){%><p class="text-sm text-slate-500">No status updates yet.</p><%}%></div></section></div>
<aside class="space-y-5"><section class="rounded-2xl bg-white p-5 ring-1 ring-slate-200"><h2 class="mb-4 text-lg font-extrabold">Update order</h2><form method="POST" action="/admin/orders/<%=order.id%>/status" class="space-y-4"><label class="block text-sm font-semibold">Order status<select name="status" class="mt-2 w-full rounded-xl border p-3"><% ['Confirmed','Processing','Packed','Shipped','Out for Delivery','Delivered','Cancelled'].forEach(s=>{%><option <%=order.status===s?'selected':''%>><%=s%></option><%})%></select></label><label class="block text-sm font-semibold">Expected delivery date<input type="date" name="expected_delivery_date" value="<%=order.expected_delivery_date?new Date(order.expected_delivery_date).toISOString().slice(0,10):''%>" class="mt-2 w-full rounded-xl border p-3"></label><label class="block text-sm font-semibold">Payment status<select name="payment_status" class="mt-2 w-full rounded-xl border p-3"><% ['Pending','Paid','Failed','Refunded','COD - Due'].forEach(s=>{%><option <%=order.payment_status===s?'selected':''%>><%=s%></option><%})%></select></label><label class="block text-sm font-semibold">Timeline note<textarea name="note" rows="3" placeholder="e.g. Handed over to delivery partner" class="mt-2 w-full rounded-xl border p-3 font-normal"></textarea></label><button class="w-full rounded-xl bg-[#174a34] p-3 font-bold text-white">Save order update</button></form></section><section class="rounded-2xl bg-emerald-950 p-5 text-white"><p class="text-xs font-bold uppercase tracking-widest text-emerald-200">Order summary</p><p class="mt-3 text-3xl font-extrabold">₹<%=Number(order.total||0).toLocaleString('en-IN')%></p><p class="mt-2 text-sm text-emerald-100">Payment: <%=order.payment_method||'COD'%> · <%=order.payment_status||'Pending'%></p><p class="mt-1 text-sm text-emerald-100">Status: <%=order.status%></p></section></aside></div>
